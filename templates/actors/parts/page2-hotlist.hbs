{{!-- PAGE 2: GEAR SLOTS & STORY --}}
<div class="dcc-page-container">

  <div class="dcc-page2-grid">
    {{!-- GEAR SLOTS / TATTOOS / PATCHES --}}
    <div class="dcc-stat-block">
      <div class="dcc-banner-header">GEAR SLOTS / TATTOOS / PATCHES</div>
      <div class="dcc-gear-slots-list">
        <div class="dcc-gear-row">
          <span class="dcc-gear-label">Head</span>
          <div style="display: flex; gap: 4px; flex: 1; align-items: center;">
            {{#if equippedBySlot.head}}
              <span class="dcc-badge" style="background: #c0392b; color: #fff; padding: 2px 6px; font-size: 10px; border-radius: 3px; white-space: nowrap;" title="{{equippedBySlot.head.bonusesSummary}}">
                <i class="fa-solid fa-shield-halved"></i> {{equippedBySlot.head.name}}
              </span>
            {{/if}}
            <input class="dcc-field-input actor-inline-edit" data-field="system.gearSlots.head" type="text" value="{{system.gearSlots.head}}" placeholder="{{#if equippedBySlot.head}}{{equippedBySlot.head.name}}{{else}}Notes...{{/if}}" />
          </div>
        </div>
        <div class="dcc-gear-row">
          <span class="dcc-gear-label">Torso</span>
          <div style="display: flex; gap: 4px; flex: 1; align-items: center;">
            {{#if equippedBySlot.torso}}
              <span class="dcc-badge" style="background: #c0392b; color: #fff; padding: 2px 6px; font-size: 10px; border-radius: 3px; white-space: nowrap;" title="{{equippedBySlot.torso.bonusesSummary}}">
                <i class="fa-solid fa-shield-halved"></i> {{equippedBySlot.torso.name}}
              </span>
            {{/if}}
            <input class="dcc-field-input actor-inline-edit" data-field="system.gearSlots.torso" type="text" value="{{system.gearSlots.torso}}" placeholder="{{#if equippedBySlot.torso}}{{equippedBySlot.torso.name}}{{else}}Notes...{{/if}}" />
          </div>
        </div>
        <div class="dcc-gear-row">
          <span class="dcc-gear-label">Arms</span>
          <div style="display: flex; gap: 4px; flex: 1; align-items: center;">
            {{#if equippedBySlot.arms}}
              <span class="dcc-badge" style="background: #c0392b; color: #fff; padding: 2px 6px; font-size: 10px; border-radius: 3px; white-space: nowrap;" title="{{equippedBySlot.arms.bonusesSummary}}">
                <i class="fa-solid fa-shield-halved"></i> {{equippedBySlot.arms.name}}
              </span>
            {{/if}}
            <input class="dcc-field-input actor-inline-edit" data-field="system.gearSlots.arms" type="text" value="{{system.gearSlots.arms}}" placeholder="{{#if equippedBySlot.arms}}{{equippedBySlot.arms.name}}{{else}}Notes...{{/if}}" />
          </div>
        </div>
        <div class="dcc-gear-row">
          <span class="dcc-gear-label">Hands/Holding</span>
          <div style="display: flex; gap: 4px; flex: 1; align-items: center;">
            {{#if equippedBySlot.hands}}
              <span class="dcc-badge" style="background: #c0392b; color: #fff; padding: 2px 6px; font-size: 10px; border-radius: 3px; white-space: nowrap;" title="{{equippedBySlot.hands.bonusesSummary}}">
                <i class="fa-solid fa-shield-halved"></i> {{equippedBySlot.hands.name}}
              </span>
            {{/if}}
            <input class="dcc-field-input actor-inline-edit" data-field="system.gearSlots.hands" type="text" value="{{system.gearSlots.hands}}" placeholder="{{#if equippedBySlot.hands}}{{equippedBySlot.hands.name}}{{else}}Notes...{{/if}}" />
          </div>
        </div>
        <div class="dcc-gear-row">
          <span class="dcc-gear-label">Legs</span>
          <div style="display: flex; gap: 4px; flex: 1; align-items: center;">
            {{#if equippedBySlot.legs}}
              <span class="dcc-badge" style="background: #c0392b; color: #fff; padding: 2px 6px; font-size: 10px; border-radius: 3px; white-space: nowrap;" title="{{equippedBySlot.legs.bonusesSummary}}">
                <i class="fa-solid fa-shield-halved"></i> {{equippedBySlot.legs.name}}
              </span>
            {{/if}}
            <input class="dcc-field-input actor-inline-edit" data-field="system.gearSlots.legs" type="text" value="{{system.gearSlots.legs}}" placeholder="{{#if equippedBySlot.legs}}{{equippedBySlot.legs.name}}{{else}}Notes...{{/if}}" />
          </div>
        </div>
        <div class="dcc-gear-row">
          <span class="dcc-gear-label">Feet</span>
          <div style="display: flex; gap: 4px; flex: 1; align-items: center;">
            {{#if equippedBySlot.feet}}
              <span class="dcc-badge" style="background: #c0392b; color: #fff; padding: 2px 6px; font-size: 10px; border-radius: 3px; white-space: nowrap;" title="{{equippedBySlot.feet.bonusesSummary}}">
                <i class="fa-solid fa-shield-halved"></i> {{equippedBySlot.feet.name}}
              </span>
            {{/if}}
            <input class="dcc-field-input actor-inline-edit" data-field="system.gearSlots.feet" type="text" value="{{system.gearSlots.feet}}" placeholder="{{#if equippedBySlot.feet}}{{equippedBySlot.feet.name}}{{else}}Notes...{{/if}}" />
          </div>
        </div>
        <div class="dcc-gear-row">
          <span class="dcc-gear-label">Accessories (Max 10)</span>
          <div style="display: flex; flex-direction: column; gap: 4px; flex: 1;">
            {{#if equippedBySlot.accessory.length}}
              <div style="display: flex; flex-wrap: wrap; gap: 4px;">
                {{#each equippedBySlot.accessory as |acc|}}
                  <span class="dcc-badge" style="background: #c0392b; color: #fff; padding: 1px 5px; font-size: 9px; border-radius: 2px;" title="{{acc.bonusesSummary}}">
                    {{acc.name}}
                  </span>
                {{/each}}
              </div>
            {{/if}}
            <textarea class="dcc-field-input actor-inline-edit" data-field="system.gearSlots.accessories" style="height: 100px; resize: vertical;">{{system.gearSlots.accessories}}</textarea>
          </div>
        </div>
      </div>
    </div>

    {{!-- RIGHT COLUMN: POPULARITY, TRAUMA, REGRETS --}}
    <div class="dcc-story-column">
      <div class="dcc-story-box">
        <span class="dcc-field-label">Popularity</span>
        <input class="dcc-field-input" type="text" name="system.details.popularity" value="{{system.details.popularity}}" />
      </div>

      <div class="dcc-story-box">
        <div class="dcc-story-box-header flexrow">
          <span class="dcc-field-label">Past Trauma (Table 11)</span>
          <button type="button" class="dcc-roll-story-table-btn" data-table="pastTrauma" title="Roll 1d12 on Table 11: Past Traumas">
            <i class="fa-solid fa-dice-d20"></i> Roll 1d12
          </button>
        </div>
        <textarea class="dcc-field-input" name="system.details.pastTrauma" style="height: 70px;" placeholder="Type custom trauma or click Roll 1d12...">{{system.details.pastTrauma}}</textarea>
      </div>

      <div class="dcc-story-box">
        <div class="dcc-story-box-header flexrow">
          <span class="dcc-field-label">Loose Ends (Table 12)</span>
          <button type="button" class="dcc-roll-story-table-btn" data-table="looseEnds" title="Roll 1d12 on Table 12: Loose Ends">
            <i class="fa-solid fa-dice-d20"></i> Roll 1d12
          </button>
        </div>
        <textarea class="dcc-field-input" name="system.details.looseEnds" style="height: 70px;" placeholder="Type custom loose ends or click Roll 1d12...">{{system.details.looseEnds}}</textarea>
      </div>

      <div class="dcc-story-box">
        <div class="dcc-story-box-header flexrow">
          <span class="dcc-field-label">Regrets (Table 13)</span>
          <button type="button" class="dcc-roll-story-table-btn" data-table="regrets" title="Roll 1d12 on Table 13: Regrets">
            <i class="fa-solid fa-dice-d20"></i> Roll 1d12
          </button>
        </div>
        <textarea class="dcc-field-input" name="system.details.regrets" style="height: 70px;" placeholder="Type custom regrets or click Roll 1d12...">{{system.details.regrets}}</textarea>
      </div>

      {{#unless isMob}}
      <div class="dcc-story-box">
        <span class="dcc-field-label">Notes</span>
        <textarea class="dcc-field-input" name="system.details.notes" style="height: 100px;">{{system.details.notes}}</textarea>
      </div>
      {{/unless}}
    </div>
  </div>
</div>
