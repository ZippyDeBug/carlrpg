{{!-- PAGE 1: CORE CHARACTER SHEET --}}
<div class="dcc-page1-container">
  {{!-- HEADER --}}
  <header class="dcc-header-grid">
    <div class="dcc-logo-box">
      <div class="dcc-logo-title">Dungeon Crawler Carl</div>
      <div class="dcc-logo-subtitle">Roleplaying Game</div>
      <button type="button" class="dcc-btn-save-pdf" title="Save Crawler to Fillable PDF">
        <i class="fa-solid fa-file-pdf"></i> Save to PDF
      </button>
    </div>
    
    <div class="dcc-details-container">
      {{#if isMob}}
      <div class="dcc-field-row">
        <div class="dcc-field-group flex-2">
          <span class="dcc-field-label">Name</span>
          <input class="dcc-field-input" name="name" type="text" value="{{actor.name}}" placeholder="Mob Name" />
        </div>
        <div class="dcc-field-group flex-1">
          <span class="dcc-field-label">Classification</span>
          <select class="dcc-field-input" name="system.details.classification">
            {{#each mobClassifications as |opt|}}
              <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
            {{/each}}
          </select>
        </div>
        <div class="dcc-field-group small">
          <span class="dcc-field-label">Level</span>
          <input class="dcc-field-input" name="system.details.level" type="number" value="{{system.details.level}}" placeholder="1" />
        </div>
        <div class="dcc-field-group flex-1">
          <span class="dcc-field-label">Creature Type</span>
          <select class="dcc-field-input" name="system.details.creatureType">
            <option value="">-- None / Unknown --</option>
            {{#each mobCreatureTypes as |opt|}}
              <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
            {{/each}}
          </select>
        </div>
      </div>

      <div class="dcc-field-row">
        <div class="dcc-field-group flex-1">
          <span class="dcc-field-label">Floor</span>
          <select class="dcc-field-input" name="system.details.floor">
            {{#each floorOptions as |opt|}}
              <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
            {{/each}}
          </select>
        </div>
        <div class="dcc-field-group flex-2">
          <span class="dcc-field-label">Location</span>
          <input class="dcc-field-input" name="system.details.location" type="text" value="{{system.details.location}}" placeholder="Location" />
        </div>
        <div class="dcc-field-group flex-1">
          <span class="dcc-field-label">XP Value</span>
          <input class="dcc-field-input" name="system.attributes.xp" type="number" value="{{system.attributes.xp}}" placeholder="0" />
        </div>
        <div class="dcc-field-group flex-2">
          <span class="dcc-field-label">Treasure</span>
          <input class="dcc-field-input" name="system.attributes.treasure" type="text" value="{{system.attributes.treasure}}" placeholder="Treasure Drop" />
        </div>
        <div class="dcc-field-group flex-2">
          <span class="dcc-field-label">Source Citation</span>
          <input class="dcc-field-input" name="system.details.source" type="text" value="{{system.details.source}}" placeholder="Page / Book Citation" />
        </div>
      </div>
      {{else}}
      <div class="dcc-field-row">
        <div class="dcc-field-group flex-2">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span class="dcc-field-label">Name</span>
            {{#if trophyBadges.hasBadges}}
              {{{trophyBadges.html}}}
            {{/if}}
          </div>
          <input class="dcc-field-input" name="name" type="text" value="{{actor.name}}" placeholder="Crawler Name" />
        </div>
        <div class="dcc-field-group flex-1">
          <span class="dcc-field-label">Party / Team</span>
          <input class="dcc-field-input" name="system.details.party" type="text" value="{{system.details.party}}" placeholder="Party / Team" />
        </div>
        <div class="dcc-field-group flex-1">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span class="dcc-field-label">Race</span>
            {{#if system.details.race}}
              <a class="dcc-manage-race-perks-btn" data-tooltip="Manage Race Perks &amp; Detriments" style="cursor: pointer; font-size: 10px; color: #777;"><i class="fa-solid fa-gear"></i></a>
            {{/if}}
          </div>
          <select class="dcc-field-input dcc-race-selector" title="Select Character Race">
            <option value="" {{#unless system.details.race}}selected{{/unless}}>-- None / Select Race --</option>
            {{#if hasCustomRace}}
              <option value="{{system.details.race}}" selected>{{system.details.race}} (Custom)</option>
            {{/if}}
            {{#each raceOptions as |group|}}
              <optgroup label="{{group.label}}">
                {{#each group.options as |opt|}}
                  <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
                {{/each}}
              </optgroup>
            {{/each}}
          </select>
        </div>
        <div class="dcc-field-group flex-1">
          <span class="dcc-field-label">Gender/Pronouns</span>
          <input class="dcc-field-input" name="system.details.gender" type="text" value="{{system.details.gender}}" placeholder="Gender/Pronouns" />
        </div>
      </div>

      <div class="dcc-field-row">
        <div class="dcc-field-group small">
          <span class="dcc-field-label">Level</span>
          <input class="dcc-field-input" name="system.details.level" type="number" value="{{system.details.level}}" placeholder="1" />
        </div>
        <div class="dcc-field-group dcc-xp-field-group">
          <div class="dcc-xp-label-row">
            <span class="dcc-field-label">Experience</span>
            <span class="dcc-xp-pct-label">{{system.details.xp.pct}}%</span>
          </div>
          <div class="dcc-xp-input-wrapper">
            <input class="dcc-field-input dcc-xp-input" name="system.details.xp.value" type="number" value="{{system.details.xp.value}}" placeholder="0" />
            <span class="dcc-xp-max-sep">/</span>
            <span class="dcc-xp-max-val" title="Next Level at {{system.details.xp.max}} XP">{{system.details.xp.max}}</span>
          </div>
          <div class="dcc-xp-bar-track" title="{{system.details.xp.toNext}} XP to Next Level">
            <div class="dcc-xp-bar-fill" style="width: {{system.details.xp.pct}}%;"></div>
          </div>
        </div>
        <div class="dcc-field-group">
          <span class="dcc-field-label">Crawler Number</span>
          <input class="dcc-field-input" name="system.details.crawlerNumber" type="text" value="{{system.details.crawlerNumber}}" placeholder="#12345" />
        </div>
        <div class="dcc-field-group">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span class="dcc-field-label">Class</span>
            {{#if system.details.class}}
              <a class="dcc-manage-class-perks-btn" data-tooltip="Manage Class Perks &amp; Detriments" style="cursor: pointer; font-size: 10px; color: #777;"><i class="fa-solid fa-gear"></i></a>
            {{/if}}
          </div>
          <select class="dcc-field-input dcc-class-selector" title="Select Character Class">
            <option value="" {{#unless system.details.class}}selected{{/unless}}>-- None / Select Class --</option>
            {{#if hasCustomClass}}
              <option value="{{system.details.class}}" selected>{{system.details.class}} (Custom)</option>
            {{/if}}
            {{#each classOptions as |group|}}
              <optgroup label="{{group.label}}">
                {{#each group.options as |opt|}}
                  <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
                {{/each}}
              </optgroup>
            {{/each}}
          </select>
        </div>
        <div class="dcc-field-group">
          <span class="dcc-field-label">Floor</span>
          <select class="dcc-field-input" name="system.details.floor">
            {{#each floorOptions as |opt|}}
              <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
            {{/each}}
          </select>
        </div>
      </div>
      {{/if}}
    </div>
  </header>

  {{!-- HEALTH BAR --}}
  <div class="dcc-health-section">
    <div class="dcc-hp-numeric-row">
      <span class="dcc-field-label" style="margin-right: 6px;">Health</span>
      <div class="dcc-hp-input-group">
        <input class="dcc-hp-input" name="system.attributes.hp.value" type="number" value="{{system.attributes.hp.value}}" title="Current HP" />
        <span class="dcc-hp-slash">/</span>
        <input class="dcc-hp-input" name="system.attributes.hp.max" type="number" value="{{system.attributes.hp.max}}" title="Max HP ({{#if isMob}}{{system.attributes.hp.bars}} bars × {{system.attributes.hp.hpPerBar}} HP{{else}}10 × CON Mod{{/if}})" readonly />
      </div>
      {{#if isMob}}
      <span class="dcc-field-label" style="margin-left: 10px; margin-right: 4px;">Bars:</span>
      <input class="dcc-hp-input" name="system.attributes.hp.bars" type="number" value="{{system.attributes.hp.bars}}" min="1" placeholder="2" style="border: 1px solid #000; width: 44px;" title="Health Bar Slots" />
      <span class="dcc-field-label" style="margin-left: 8px; margin-right: 4px;">HP/Bar:</span>
      <input class="dcc-hp-input" name="system.attributes.hp.hpPerBar" type="number" value="{{system.attributes.hp.hpPerBar}}" placeholder="{{system.abilities.con.mod}}" style="border: 1px solid #000; width: 44px;" title="HP Per Bar (Defaults to CON Mod: {{system.abilities.con.mod}})" />
      {{/if}}
      <span class="dcc-field-label" style="margin-left: 10px; margin-right: 4px;">Temp:</span>
      <input class="dcc-hp-input" name="system.attributes.hp.temp" type="number" value="{{system.attributes.hp.temp}}" placeholder="0" style="border: 1px solid #000; width: 44px;" />
      {{#if hasTempBars}}
      <span class="dcc-temp-bars-badge" style="margin-left: 6px; background: #fff8e7; color: #b7791f; border: 1.5px solid #d4af37; padding: 2px 6px; border-radius: 3px; font-weight: bold; font-size: 11px; display: inline-flex; align-items: center; gap: 4px;" title="{{tempBarsSource}} ({{system.attributes.hp.tempBars.count}} / {{system.attributes.hp.tempBars.maxCount}} slots)">
        <i class="fa-solid fa-shield-heart" style="color: #d4af37;"></i> +{{system.attributes.hp.tempBars.count}} Bonus Bars ({{system.attributes.hp.temp}} HP)
      </span>
      {{/if}}

      {{#unless isMob}}
      <div class="dcc-rest-buttons-group">
        <span class="dcc-rest-label" title="Rest to recover Health and Mana"><i class="fa-solid fa-bed"></i> Rest:</span>
        <button type="button" class="dcc-rest-btn" data-rest-type="1hour" data-tooltip="1-Hour Non-Combat Rest: Recovers 1 Health Bar slot (+{{hpPerBar}} HP) and 5 Mana." title="1-Hour Non-Combat Rest: +1 HB slot (+{{hpPerBar}} HP) and +5 Mana">
          1h
        </button>
        <button type="button" class="dcc-rest-btn" data-rest-type="short" data-tooltip="2-Hour Short Rest: Recovers 5 Health Bar slots (+{{fiveHpBars}} HP) and half Mana (round down)." title="2-Hour Short Rest: +5 HB slots (+{{fiveHpBars}} HP) and half Mana">
          2h Short
        </button>
        <button type="button" class="dcc-rest-btn" data-rest-type="long" data-tooltip="8-Hour Safe Room Long Rest: Fully restores all 10 Health Bars and Mana. Clears all stacked Fatigued debuffs." title="8-Hour Safe Room Long Rest: Full HP/Mana and clears fatigue">
          8h Safe Room
        </button>
        <button type="button" class="dcc-rest-btn" data-rest-type="fullDay" data-tooltip="30-Hour Full Day Rest: Complete regeneration. Restores Health, Mana, clears fatigue, and recovers from all Injuries." title="30-Hour Full Day Rest: Full HP/Mana, clear fatigue, and heal all injuries">
          30h Full Day
        </button>

        {{!-- Start Grinding Button --}}
        <button type="button" class="open-grind-app dcc-start-grind-btn" data-tooltip="Start Grind: Open Party Grinding & Downtime Hub (train skills, earn hours, advance ranks)" title="Start Grinding & Downtime Session">
          <i class="fa-solid fa-dumbbell"></i> Start Grind
        </button>
      </div>
      {{/unless}}
    </div>

    {{#if hasTempBars}}
    <div class="dcc-temp-bars-container" data-tooltip="Temporary Shield: {{tempBarsSource}} ({{system.attributes.hp.tempBars.count}} active slots)">
      <div class="dcc-temp-bars-header">
        <span class="dcc-temp-bars-title"><i class="fa-solid fa-shield-halved"></i> Temporary Shield: {{tempBarsSource}}</span>
        <span class="dcc-temp-bars-count">{{system.attributes.hp.tempBars.count}} / {{system.attributes.hp.tempBars.maxCount}} Slots ({{system.attributes.hp.tempBars.currentSlotHp}} / {{system.attributes.hp.tempBars.hpPerSlot}} HP in current slot)</span>
      </div>
      <div class="dcc-temp-bars-grid" style="grid-template-columns: repeat({{tempBarSlots.length}}, 1fr);">
        {{#each tempBarSlots}}
        <div class="dcc-temp-bar-slot {{#if this.isDepleted}}depleted{{else if this.isCurrentActive}}active{{else}}full{{/if}}" data-tooltip="Slot {{this.index}}: {{this.label}} HP">
          <div class="dcc-temp-bar-fill" style="width: {{this.fillPct}}%;"></div>
          <span class="dcc-temp-bar-label">{{this.label}}</span>
        </div>
        {{/each}}
      </div>
    </div>
    {{/if}}

    <div class="dcc-health-bar-wrapper" style="--hp-val: {{system.attributes.hp.value}}; --hp-max: {{system.attributes.hp.max}}; --hp-pct: {{system.attributes.hp.pct}}; --hp-segments: {{healthSegments.length}};" data-tooltip="HP: {{system.attributes.hp.value}} / {{system.attributes.hp.max}}">
      <div class="dcc-health-fill-overlay"></div>
      <div class="dcc-health-segments" style="grid-template-columns: repeat({{healthSegments.length}}, 1fr);">
        {{#each healthSegments}}
        <div class="dcc-hp-seg">{{this.label}}</div>
        {{/each}}
      </div>
    </div>
  </div>

  {{!-- MAIN GRID --}}
  <div class="dcc-main-grid">
    {{!-- LEFT COLUMN: 5 STATS --}}
    <div class="dcc-attributes-column">
      {{!-- Strength --}}
      <div class="dcc-attribute-card">
        <div class="dcc-attribute-title">Strength</div>
        <div class="dcc-attribute-values">
          <div class="dcc-stat-box">
            <input class="dcc-stat-input" name="system.abilities.str.value" type="number" value="{{system.abilities.str.value}}" readonly title="Enhanced: {{system.abilities.str.unenhanced}} base{{#if system.abilities.str.gearBonus}} ({{#if (gt system.abilities.str.gearBonus 0)}}+{{/if}}{{system.abilities.str.gearBonus}} gear){{/if}}" />
            <span class="dcc-stat-sublabel dcc-stat-enhanced-label">Enhanced</span>
          </div>
          <span class="dcc-stat-slash">/</span>
          <div class="dcc-stat-box">
            <input class="dcc-stat-input" name="system.abilities.str.unenhanced" type="number" value="{{system.abilities.str.unenhanced}}" placeholder="10" title="Base Unenhanced Score" />
            <span class="dcc-stat-sublabel dcc-stat-unenhanced-label">Unenhanced</span>
          </div>
        </div>
        <div class="dcc-attribute-mod-container">
          <span class="dcc-mod-label">STR MOD</span>
          <a class="dcc-mod-value roll-stat" data-stat="str" data-tooltip="Roll Strength Check">{{numberFormat system.abilities.str.mod sign=true}}</a>
        </div>
      </div>

      {{!-- Intelligence --}}
      <div class="dcc-attribute-card">
        <div class="dcc-attribute-title">Intelligence</div>
        <div class="dcc-attribute-values">
          <div class="dcc-stat-box">
            <input class="dcc-stat-input" name="system.abilities.int.value" type="number" value="{{system.abilities.int.value}}" readonly title="Enhanced: {{system.abilities.int.unenhanced}} base{{#if system.abilities.int.gearBonus}} ({{#if (gt system.abilities.int.gearBonus 0)}}+{{/if}}{{system.abilities.int.gearBonus}} gear){{/if}}" />
            <span class="dcc-stat-sublabel dcc-stat-enhanced-label">Enhanced</span>
          </div>
          <span class="dcc-stat-slash">/</span>
          <div class="dcc-stat-box">
            <input class="dcc-stat-input" name="system.abilities.int.unenhanced" type="number" value="{{system.abilities.int.unenhanced}}" placeholder="10" title="Base Unenhanced Score" />
            <span class="dcc-stat-sublabel dcc-stat-unenhanced-label">Unenhanced</span>
          </div>
        </div>
        <div class="dcc-attribute-mod-container">
          <span class="dcc-mod-label">INT MOD</span>
          <a class="dcc-mod-value roll-stat" data-stat="int" data-tooltip="Roll Intelligence Check">{{numberFormat system.abilities.int.mod sign=true}}</a>
        </div>
      </div>

      {{!-- Constitution --}}
      <div class="dcc-attribute-card">
        <div class="dcc-attribute-title">Constitution</div>
        <div class="dcc-attribute-values">
          <div class="dcc-stat-box">
            <input class="dcc-stat-input" name="system.abilities.con.value" type="number" value="{{system.abilities.con.value}}" readonly title="Enhanced: {{system.abilities.con.unenhanced}} base{{#if system.abilities.con.gearBonus}} ({{#if (gt system.abilities.con.gearBonus 0)}}+{{/if}}{{system.abilities.con.gearBonus}} gear){{/if}}" />
            <span class="dcc-stat-sublabel dcc-stat-enhanced-label">Enhanced</span>
          </div>
          <span class="dcc-stat-slash">/</span>
          <div class="dcc-stat-box">
            <input class="dcc-stat-input" name="system.abilities.con.unenhanced" type="number" value="{{system.abilities.con.unenhanced}}" placeholder="10" title="Base Unenhanced Score" />
            <span class="dcc-stat-sublabel dcc-stat-unenhanced-label">Unenhanced</span>
          </div>
        </div>
        <div class="dcc-attribute-mod-container">
          <span class="dcc-mod-label">CON MOD</span>
          <a class="dcc-mod-value roll-stat" data-stat="con" data-tooltip="Roll Constitution Check">{{numberFormat system.abilities.con.mod sign=true}}</a>
        </div>
      </div>

      {{!-- Dexterity --}}
      <div class="dcc-attribute-card">
        <div class="dcc-attribute-title">Dexterity</div>
        <div class="dcc-attribute-values">
          <div class="dcc-stat-box">
            <input class="dcc-stat-input" name="system.abilities.dex.value" type="number" value="{{system.abilities.dex.value}}" readonly title="Enhanced: {{system.abilities.dex.unenhanced}} base{{#if system.abilities.dex.gearBonus}} ({{#if (gt system.abilities.dex.gearBonus 0)}}+{{/if}}{{system.abilities.dex.gearBonus}} gear){{/if}}" />
            <span class="dcc-stat-sublabel dcc-stat-enhanced-label">Enhanced</span>
          </div>
          <span class="dcc-stat-slash">/</span>
          <div class="dcc-stat-box">
            <input class="dcc-stat-input" name="system.abilities.dex.unenhanced" type="number" value="{{system.abilities.dex.unenhanced}}" placeholder="10" title="Base Unenhanced Score" />
            <span class="dcc-stat-sublabel dcc-stat-unenhanced-label">Unenhanced</span>
          </div>
        </div>
        <div class="dcc-attribute-mod-container">
          <span class="dcc-mod-label">DEX MOD</span>
          <a class="dcc-mod-value roll-stat" data-stat="dex" data-tooltip="Roll Dexterity Check">{{numberFormat system.abilities.dex.mod sign=true}}</a>
        </div>
      </div>

      {{!-- Charisma --}}
      <div class="dcc-attribute-card">
        <div class="dcc-attribute-title">Charisma</div>
        <div class="dcc-attribute-values">
          <div class="dcc-stat-box">
            <input class="dcc-stat-input" name="system.abilities.cha.value" type="number" value="{{system.abilities.cha.value}}" readonly title="Enhanced: {{system.abilities.cha.unenhanced}} base{{#if system.abilities.cha.gearBonus}} ({{#if (gt system.abilities.cha.gearBonus 0)}}+{{/if}}{{system.abilities.cha.gearBonus}} gear){{/if}}" />
            <span class="dcc-stat-sublabel dcc-stat-enhanced-label">Enhanced</span>
          </div>
          <span class="dcc-stat-slash">/</span>
          <div class="dcc-stat-box">
            <input class="dcc-stat-input" name="system.abilities.cha.unenhanced" type="number" value="{{system.abilities.cha.unenhanced}}" placeholder="10" title="Base Unenhanced Score" />
            <span class="dcc-stat-sublabel dcc-stat-unenhanced-label">Unenhanced</span>
          </div>
        </div>
        <div class="dcc-attribute-mod-container">
          <span class="dcc-mod-label">CHA MOD</span>
          <a class="dcc-mod-value roll-stat" data-stat="cha" data-tooltip="Roll Charisma Check">{{numberFormat system.abilities.cha.mod sign=true}}</a>
        </div>
      </div>
    </div>

    {{!-- MIDDLE COMBAT COLUMN --}}
    <div class="dcc-combat-column">
      {{!-- EVADE --}}
      <div class="dcc-stat-block">
        <div class="dcc-banner-header">
          <span>EVADE</span>
          <a class="roll-evade" data-tooltip="Roll Evade Check" style="color: #fff; cursor: pointer;"><i class="fa-solid fa-dice-d20"></i></a>
        </div>
        <div class="dcc-formula-row">
          <span class="dcc-formula-operator">d20 +</span>
          <div class="dcc-formula-item">
            <input class="dcc-box-input small" type="number" value="{{system.abilities.dex.mod}}" readonly />
            <span class="dcc-stat-sublabel">DEX Mod</span>
          </div>
          <span class="dcc-formula-operator">+</span>
          <div class="dcc-formula-item">
            <input class="dcc-box-input small" type="number" value="{{system.attributes.evade.items}}" readonly title="Items / Equipped Gear Bonus" />
            <span class="dcc-stat-sublabel">Items</span>
          </div>
          <span class="dcc-formula-operator">+</span>
          <div class="dcc-formula-item">
            <input class="dcc-box-input small" name="system.attributes.evade.buffs" type="number" value="{{system.attributes.evade.buffs}}" placeholder="0" />
            <span class="dcc-stat-sublabel">Buffs</span>
          </div>
          <span class="dcc-formula-operator">=</span>
          <div class="dcc-formula-item">
            <input class="dcc-box-input medium" type="number" value="{{system.attributes.evade.total}}" readonly />
            <span class="dcc-stat-sublabel">Evade Total</span>
          </div>
        </div>
      </div>

      {{!-- DAMAGE RESISTANCE --}}
      <div class="dcc-stat-block">
        <div class="dcc-banner-header">DAMAGE RESISTANCE</div>
        <div class="dcc-formula-row">
          <div class="dcc-formula-item">
            <input class="dcc-box-input medium" name="system.attributes.dr.armor" type="number" value="{{system.attributes.dr.armor}}" placeholder="0" />
            <span class="dcc-stat-sublabel">Armor</span>
          </div>
          <span class="dcc-formula-operator">+</span>
          <div class="dcc-formula-item">
            <input class="dcc-box-input small" type="number" value="{{system.attributes.dr.items}}" readonly title="Items / Equipped Gear DR Bonus" />
            <span class="dcc-stat-sublabel">Items</span>
          </div>
          <span class="dcc-formula-operator">+</span>
          <div class="dcc-formula-item">
            <input class="dcc-box-input medium" name="system.attributes.dr.buffs" type="number" value="{{system.attributes.dr.buffs}}" placeholder="0" />
            <span class="dcc-stat-sublabel">Buffs</span>
          </div>
          <span class="dcc-formula-operator">=</span>
          <div class="dcc-formula-item">
            <input class="dcc-box-input medium" type="number" value="{{system.attributes.dr.total}}" readonly />
            <span class="dcc-stat-sublabel">DR Total</span>
          </div>
        </div>
      </div>

      {{!-- MOVEMENT & CHARACTER ATTRIBUTES --}}
      <div class="dcc-sub-combat-grid">
        <div class="dcc-stat-block">
          <div class="dcc-banner-header">MOVEMENT</div>
          <div class="dcc-formula-row dcc-centered-row">
            <div class="dcc-formula-item">
              <input class="dcc-box-input medium" name="system.attributes.speed.move" type="number" value="{{system.attributes.speed.move}}" placeholder="20" />
              <span class="dcc-stat-sublabel">Move (ft)</span>
            </div>
            <div class="dcc-formula-item">
              <input class="dcc-box-input medium" name="system.attributes.speed.step" type="number" value="{{system.attributes.speed.step}}" placeholder="10" />
              <span class="dcc-stat-sublabel">Step (ft)</span>
            </div>
          </div>
        </div>

        <div class="dcc-stat-block">
          <div class="dcc-banner-header">AI FAVOR &amp; SIZE</div>
          <div class="dcc-formula-row dcc-centered-row">
            <div class="dcc-formula-item">
              <input class="dcc-box-input medium" name="system.attributes.aiFavor" type="number" value="{{system.attributes.aiFavor}}" placeholder="0" />
              <span class="dcc-stat-sublabel">AI Favor</span>
            </div>
            <div class="dcc-formula-item">
              <select class="dcc-box-input dcc-size-select" name="system.attributes.size" title="Creature Size Category">
                {{#each sizeOptions}}
                  <option value="{{this.name}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                {{/each}}
              </select>
              <span class="dcc-stat-sublabel">Size</span>
            </div>
          </div>
        </div>

        <div class="dcc-stat-block">
          <div class="dcc-banner-header" style="display: flex; justify-content: space-between; align-items: center;">
            <span>LIMBS &amp; PHYSIOLOGY</span>
            {{#if isGM}}<span style="font-size: 9px; color: #f1c40f;"><i class="fa-solid fa-crown"></i> GM</span>{{/if}}
          </div>
          <div class="dcc-formula-row dcc-centered-row">
            <div class="dcc-formula-item" title="Hands: {{system.attributes.limbs.usedHands}} used of {{system.attributes.limbs.maxHands}} max">
              {{#if isGM}}
                <input class="dcc-box-input small dcc-limb-quick-edit {{#if system.attributes.limbs.exceededHands}}is-exceeded-input{{/if}}" data-field="system.attributes.limbs.hands" type="number" value="{{system.attributes.limbs.hands}}" min="0" />
              {{else}}
                <input class="dcc-box-input small {{#if system.attributes.limbs.exceededHands}}is-exceeded-input{{/if}}" type="number" value="{{system.attributes.limbs.hands}}" readonly disabled />
              {{/if}}
              <span class="dcc-stat-sublabel">Hands ({{system.attributes.limbs.usedHands}}/{{system.attributes.limbs.maxHands}})</span>
            </div>
            <div class="dcc-formula-item" title="Arms: Base {{system.attributes.limbs.arms}} (Max: {{system.attributes.limbs.maxArms}})">
              {{#if isGM}}
                <input class="dcc-box-input small dcc-limb-quick-edit" data-field="system.attributes.limbs.arms" type="number" value="{{system.attributes.limbs.arms}}" min="0" />
              {{else}}
                <input class="dcc-box-input small" type="number" value="{{system.attributes.limbs.arms}}" readonly disabled />
              {{/if}}
              <span class="dcc-stat-sublabel">Arms ({{system.attributes.limbs.maxArms}})</span>
            </div>
            <div class="dcc-formula-item" title="Legs: Base {{system.attributes.limbs.legs}} (Max: {{system.attributes.limbs.maxLegs}})">
              {{#if isGM}}
                <input class="dcc-box-input small dcc-limb-quick-edit" data-field="system.attributes.limbs.legs" type="number" value="{{system.attributes.limbs.legs}}" min="0" />
              {{else}}
                <input class="dcc-box-input small" type="number" value="{{system.attributes.limbs.legs}}" readonly disabled />
              {{/if}}
              <span class="dcc-stat-sublabel">Legs ({{system.attributes.limbs.maxLegs}})</span>
            </div>
          </div>
        </div>
      </div>

      {{#if isMob}}
      <div class="dcc-stat-block" style="margin-top: 8px;">
        <div class="dcc-banner-header">DIFFICULTIES &amp; COMBAT VALUES</div>
        <div class="dcc-formula-row dcc-centered-row">
          <div class="dcc-formula-item">
            <input class="dcc-box-input medium" name="system.attributes.evadeDifficulty" type="text" value="{{system.attributes.evadeDifficulty}}" placeholder="12+F" title="Evade Difficulty (e.g. 12+F) — Effective DC {{system.attributes.effectiveEvadeDC}} on Floor {{currentFloor}}" />
            <span class="dcc-stat-sublabel">Evade Diff (DC {{system.attributes.effectiveEvadeDC}})</span>
          </div>
          <div class="dcc-formula-item">
            <input class="dcc-box-input medium" name="system.attributes.surpriseDifficulty" type="text" value="{{system.attributes.surpriseDifficulty}}" placeholder="11+F" title="Surprise Difficulty (e.g. 11+F)" />
            <span class="dcc-stat-sublabel">Surprise Diff</span>
          </div>
        </div>
      </div>
      {{/if}}

      {{!-- MANA & DEBUFFS --}}
      <div class="dcc-mana-debuffs">
        <div class="dcc-mana-box">
          <span class="dcc-field-label">Current Mana / Max Mana</span>
          <div class="dcc-mana-values">
            <input class="dcc-stat-input" name="system.attributes.mana.value" type="number" value="{{system.attributes.mana.value}}" placeholder="10" title="Current Mana" />
            <span class="dcc-stat-slash">/</span>
            <input class="dcc-stat-input" name="system.attributes.mana.max" type="number" value="{{system.attributes.mana.max}}" title="Max Mana (Enhanced INT)" readonly />
          </div>
        </div>
        <div class="dcc-debuffs-box">
          <div class="dcc-banner-header" style="display: flex; justify-content: space-between; align-items: center;">
            <span>DEBUFFS & CONDITIONS</span>
            <div style="display: flex; gap: 8px; align-items: center;">
              <a class="open-debuff-picker" data-tooltip="Browse Conditions Compendium" style="color: #f1c40f; cursor: pointer; font-size: 10px; font-weight: normal; text-transform: none;">
                <i class="fa-solid fa-book-skull"></i> Browse
              </a>
              <a class="item-create" data-type="debuff" data-tooltip="Add Custom Debuff" style="color: #fff; cursor: pointer; font-size: 10px; font-weight: normal; text-transform: none;">
                <i class="fa-solid fa-plus"></i> Add
              </a>
            </div>
          </div>
          {{#if debuffs.length}}
            <div class="dcc-debuff-chips-container" style="display: flex; flex-wrap: wrap; gap: 4px; padding: 4px 6px; background: #fff5f5; border: 1px solid #e74c3c; border-radius: 3px; margin-bottom: 4px;">
              {{#each debuffs as |deb|}}
                <div class="dcc-debuff-chip {{deb.severityClass}}" data-item-id="{{deb.id}}" style="display: inline-flex; align-items: center; gap: 4px; padding: 2px 6px; border-radius: 3px; font-size: 10px; background: {{#if (eq deb.severityClass 'is-major')}}#c0392b{{else}}#d35400{{/if}}; color: #fff;" title="{{deb.name}}{{#if deb.summary}} ({{deb.summary}}){{/if}}{{#if deb.system.duration}} • {{deb.system.duration}}{{/if}}">
                  <span class="item-edit" style="cursor: pointer; font-weight: bold;">{{deb.name}}</span>
                  {{#if deb.summary}}<span style="opacity: 0.85; font-size: 9px;">({{deb.summary}})</span>{{/if}}
                  <a class="item-delete" data-tooltip="Remove {{deb.name}}" style="color: #fff; cursor: pointer; margin-left: 2px;"><i class="fa-solid fa-xmark"></i></a>
                </div>
              {{/each}}
            </div>
          {{/if}}
          <textarea class="dcc-debuffs-input" name="system.attributes.debuffs" placeholder="Debuffs, conditions, notes...">{{system.attributes.debuffs}}</textarea>
        </div>
      </div>
    </div>

    {{!-- RIGHT COLUMN: PORTRAIT & BUFFS --}}
    <div class="dcc-right-column">
      <div class="dcc-portrait-box">
        <img src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
      </div>

      <div class="dcc-external-buffs-box">
        <div class="dcc-banner-header" style="font-size: 11px; margin-bottom: 6px; display: flex; align-items: center; justify-content: space-between;">
          <span>EXTERNAL BUFFS (MAX 3)</span>
          <div style="display: flex; align-items: center; gap: 8px;">
            <a class="open-buff-picker" data-tooltip="Browse Buffs Compendium" style="color: #f1c40f; font-size: 10px; cursor: pointer;"><i class="fa-solid fa-sparkles"></i> Browse</a>
            <a class="item-create" data-type="buff" data-tooltip="Create New Buff" style="color: #fff; font-size: 10px; cursor: pointer;"><i class="fa-solid fa-plus"></i> New Buff</a>
            <span style="font-size: 9px; font-weight: normal; opacity: 0.85;">Active Effects</span>
          </div>
        </div>
        <div class="dcc-buff-slots-container">
          {{#each externalBuffSlots as |slot|}}
            <div class="dcc-buff-slot-entry {{#if slot.isEmpty}}is-empty{{else}}is-active{{/if}}" data-slot="{{slot.key}}">
              <div class="dcc-buff-slot-header">
                <span class="dcc-buff-num">{{slot.index}}.</span>
                {{#if slot.badge}}
                  <span class="dcc-buff-badge {{slot.badgeClass}}">{{slot.badge}}</span>
                {{/if}}
                {{#unless slot.isEmpty}}
                  <span class="dcc-buff-name" title="{{slot.name}}">{{slot.name}}</span>
                  {{#if slot.detail}}
                    <span class="dcc-buff-detail">{{slot.detail}}</span>
                  {{/if}}
                  <a class="external-buff-clear" data-slot="{{slot.key}}" data-tooltip="Clear Buff"><i class="fa-solid fa-xmark"></i></a>
                {{/unless}}
              </div>
              <div class="dcc-buff-select-wrapper">
                <select class="external-buff-select" data-slot="{{slot.key}}">
                  <option value="">-- {{#if slot.isEmpty}}Select Buff {{slot.index}}...{{else}}Change Buff...{{/if}} --</option>
                  {{#each slot.groups as |group|}}
                    {{#if group.items.length}}
                      <optgroup label="{{group.label}}">
                        {{#each group.items as |opt|}}
                          <option value="{{opt.id}}" {{#if opt.selected}}selected{{/if}} {{#if opt.disabled}}disabled{{/if}}>{{opt.label}}{{#if opt.disabled}} (Assigned in Slot {{opt.assignedSlot}}){{/if}}</option>
                        {{/each}}
                      </optgroup>
                    {{/if}}
                  {{/each}}
                  {{#if slot.isCustom}}
                    <option value="{{slot.value}}" selected>✏️ {{slot.name}}</option>
                  {{/if}}
                </select>
              </div>
            </div>
          {{/each}}
        </div>
      </div>
    </div>
  </div>

  {{!-- ATTACKS SECTION (BOTTOM) --}}
  {{#if system.attributes.limbs.exceededHands}}
    <div class="dcc-hands-warning-banner" role="alert" style="margin-bottom: 6px;">
      <i class="fa-solid fa-triangle-exclamation"></i>
      <span><strong>WARNING — HANDS LIMIT EXCEEDED:</strong> Wielding gear in <strong>{{system.attributes.limbs.usedHands}}</strong> hands, but only <strong>{{system.attributes.limbs.maxHands}}</strong> hands available!</span>
    </div>
  {{/if}}
  <div class="dcc-attacks-section" data-section="attacks" id="attacks-section">
    <div class="dcc-banner-header">
      <div style="display: flex; align-items: center; gap: 8px;">
        <span>ATTACKS</span>
        <span class="dcc-badge {{#if system.attributes.limbs.exceededHands}}dcc-badge-danger{{else}}dcc-badge-dark{{/if}}" style="font-size: 10px; padding: 2px 6px; border-radius: 3px; font-weight: normal; background: {{#if system.attributes.limbs.exceededHands}}#c0392b{{else}}rgba(0,0,0,0.3){{/if}}; color: #fff;" title="Equipped Weapons/Gear: {{system.attributes.limbs.usedHands}} / {{system.attributes.limbs.maxHands}} Available Hands">
          <i class="fa-solid fa-hand"></i> Hands: {{system.attributes.limbs.usedHands}}/{{system.attributes.limbs.maxHands}}
        </span>
      </div>
      <div style="display: flex; align-items: center; gap: 8px;">
        {{#if stowedAttacksCount}}
          <a class="toggle-stowed-attacks-view" style="color: #fff; cursor: pointer; font-size: 11px; text-decoration: none;" data-tooltip="Toggle Stowed / Unequipped Attacks">
            <i class="fa-solid {{#if showStowedAttacks}}fa-eye-slash{{else}}fa-box-archive{{/if}}"></i> Stowed ({{stowedAttacksCount}})
          </a>
        {{/if}}
        <a class="open-skill-picker" data-category="combat" data-tooltip="Select Attack Skill from Library" style="color: #fff; cursor: pointer; text-decoration: none;"><i class="fa-solid fa-hand-fist"></i> Select Attack</a>
        <a class="item-create" data-type="attack" data-tooltip="Add Custom Attack" style="color: #fff; cursor: pointer;"><i class="fa-solid fa-plus"></i> Add Attack</a>
      </div>
    </div>
    <table class="dcc-attacks-table">
      <thead>
        <tr>
          <th style="width: 25%;">Name</th>
          <th style="width: 20%;">TO HIT<br/><small style="font-weight: normal; font-size: 10px;">Rank + Stat Mod</small></th>
          <th style="width: 25%;">DAMAGE<br/><small style="font-weight: normal; font-size: 10px;">Dice + Stat Mod</small></th>
          <th style="width: 20%;">Effects</th>
          <th style="width: 10%;">Actions</th>
        </tr>
      </thead>
      <tbody>
        {{#each attacks as |attack|}}
          <tr data-item-id="{{attack.id}}" draggable="true">
            <td>
              <div style="display: flex; align-items: center; gap: 6px;">
                <button type="button" class="attack-toggle-equipped" data-tooltip="Equipped / Readied (Click to unequip / stow)" style="background: none; border: none; cursor: pointer; padding: 2px 4px; font-size: 14px;">
                  <i class="fa-solid fa-shield-halved" style="color: #c0392b;"></i>
                </button>
                <div>
                  <a class="roll-attack-hit" data-tooltip="Roll To Hit" style="font-weight: bold; cursor: pointer;">{{attack.name}}</a>
                  {{#if attack.isWeaponGear}}
                    <span class="dcc-stat-sublabel" style="display: inline-block; margin-left: 2px; font-size: 9px; text-transform: uppercase;">[WEAPON]</span>
                  {{/if}}
                  {{#if attack.isSkillAttack}}
                    <span class="dcc-stat-sublabel" style="display: inline-block; margin-left: 2px; font-size: 9px; text-transform: uppercase; background: #27ae60; color: #fff; padding: 1px 3px; border-radius: 2px;">[SKILL]</span>
                  {{/if}}
                </div>
              </div>
            </td>
            <td>
              <button type="button" class="dcc-attack-roll-btn roll-attack-hit" data-tooltip="Roll To Hit: {{#if attack.toHitFormula}}{{attack.toHitFormula}}{{else if attack.displayToHit}}{{attack.displayToHit}}{{/if}}{{#if attack.displayToHit}} ({{attack.displayToHit}}){{/if}}">
                {{#if attack.toHitFormula}}{{attack.toHitFormula}}{{else if attack.displayToHit}}{{attack.displayToHit}}{{else}}{{upper attack.system.toHitStat}} ({{attack.system.toHitRank}}){{/if}}
              </button>
            </td>
            <td>
              <button type="button" class="dcc-attack-roll-btn roll-attack-dmg">
                {{#if attack.displayDamage}}{{attack.displayDamage}}{{else}}{{attack.system.damageDice}} + {{upper attack.system.damageStat}}{{/if}}
              </button>
            </td>
            <td>
              {{#if attack.hasOptionalEffects}}
                <div style="display: flex; flex-direction: column; gap: 2px;">
                  <select class="attack-damage-effect-select" data-item-id="{{attack.id}}" style="font-size: 10px; height: 20px; padding: 0 4px; max-width: 140px; border: 1px solid #c0392b; border-radius: 3px; background: #fff; cursor: pointer;">
                    <option value="none" {{#if (eq attack.selectedEffect 'none')}}selected{{/if}}>None{{#if attack.favorBonus}} (+{{attack.favorBonus}} Favor){{/if}}</option>
                    {{#each (or attack.selectableDamageEffects attack.validDamageEffects) as |eff|}}
                      <option value="{{eff}}" {{#if (eq ../attack.selectedEffect eff)}}selected{{/if}}>{{eff}}</option>
                    {{/each}}
                  </select>
                  {{#if attack.displayEffects}}<span style="font-size: 10px; color: #222222;">{{attack.displayEffects}}</span>{{/if}}
                </div>
              {{else}}
                <span style="font-size: 11px;">{{#if attack.displayEffects}}{{attack.displayEffects}}{{else}}{{attack.system.effects}}{{/if}}</span>
              {{/if}}
            </td>
            <td>
              <a class="item-edit" data-tooltip="Edit Attack" style="margin-right: 4px;"><i class="fa-solid fa-edit"></i></a>
              <a class="item-delete" data-tooltip="Delete Attack"><i class="fa-solid fa-trash"></i></a>
            </td>
          </tr>
        {{else}}
          <tr>
            <td colspan="5" style="text-align: center; color: #333333; padding: 10px;">
              No attacks or weapons equipped. Equip a weapon in <strong>Inventory</strong>, click <strong>Add Attack</strong> above, or expand Stowed Attacks.
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>

    {{!-- Combat Techniques & Maneuvers Strip --}}
    {{#if combatTechniques.length}}
      <div class="dcc-combat-techniques-strip">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px;">
          <span style="font-size: 11px; font-weight: bold; text-transform: uppercase; color: #c0392b; letter-spacing: 0.5px;">
            <i class="fa-solid fa-bolt"></i> Combat Techniques &amp; Maneuvers
          </span>
          <span style="font-size: 10px; color: #555;">
            {{#if primedTechniquesCount}}
              <strong style="color: #c0392b;">{{primedTechniquesCount}} Primed</strong> (active on next strike)
            {{else}}
              Click to Prime for Next Strike
            {{/if}}
          </span>
        </div>
        <div style="display: flex; flex-wrap: wrap; gap: 6px;">
          {{#each combatTechniques as |tech|}}
            <button type="button" 
              class="dcc-technique-pill {{#if tech.isPrimed}}primed{{/if}} toggle-combat-technique" 
              data-technique-id="{{tech.id}}" 
              data-tooltip="{{tech.name}} (Rank {{tech.rank}}): {{tech.summary}}{{#if tech.notes}} — {{tech.notes}}{{/if}}">
              <i class="fa-solid {{tech.icon}}"></i>
              <span class="dcc-tech-name">{{tech.name}}</span>
              <span class="dcc-tech-summary">{{tech.summary}}</span>
              {{#if tech.isPrimed}}
                <span class="dcc-tech-badge">PRIMED</span>
              {{/if}}
            </button>
          {{/each}}
        </div>
      </div>
    {{/if}}

    {{#if showStowedAttacks}}
      <div class="dcc-stat-block" style="margin-top: 6px; border: 1px dashed #c0392b; background: #fffaf9; padding: 6px;">
        <div style="font-size: 11px; font-weight: bold; color: #c0392b; margin-bottom: 4px; display: flex; justify-content: space-between; align-items: center;">
          <span><i class="fa-solid fa-box-archive"></i> STOWED / UNEQUIPPED ATTACKS &amp; WEAPONS</span>
          <span style="font-size: 10px; color: #333333; font-weight: normal;">Click to ready in combat</span>
        </div>
        <table class="dcc-attacks-table" style="margin: 0; font-size: 11px;">
          <tbody>
            {{#each stowedAttacks as |stowed|}}
              <tr data-item-id="{{stowed.id}}">
                <td style="width: 35%;">
                  <button type="button" class="attack-toggle-equipped" data-tooltip="Equip / Ready Attack" style="background: none; border: none; cursor: pointer; padding: 2px 4px;">
                    <i class="fa-regular fa-circle" style="color: #444444;"></i>
                  </button>
                  <span style="font-weight: bold;">{{stowed.name}}</span>
                  {{#if stowed.isWeaponGear}}
                    <span class="dcc-stat-sublabel" style="font-size: 9px; text-transform: uppercase;">[{{stowed.system.slot}}]</span>
                  {{/if}}
                </td>
                <td style="width: 35%;">
                  <span style="font-size: 10px; color: #333333;">
                    {{#if stowed.displayDamage}}{{stowed.displayDamage}}{{else}}{{stowed.system.damageDice}}{{/if}}
                  </span>
                </td>
                <td style="width: 30%; text-align: right;">
                  <button type="button" class="dcc-btn attack-toggle-equipped" style="font-size: 10px; padding: 2px 6px; background: #c0392b; color: #fff; border: 1px solid #962d22; border-radius: 2px; cursor: pointer;">
                    <i class="fa-solid fa-shield-halved"></i> Ready / Equip
                  </button>
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    {{/if}}
  </div>

  {{#if spells.length}}
  {{!-- SPELLS & MAGIC SECTION (PAGE 1 QUICK-ACCESS) --}}
  <div class="dcc-attacks-section mob-spells-section" style="margin-top: 8px;">
    <div class="dcc-banner-header" style="display: flex; justify-content: space-between; align-items: center; background: linear-gradient(90deg, #1b3a4b 0%, #2980b9 100%);">
      <span><i class="fa-solid fa-wand-magic-sparkles"></i> SPELLS &amp; MAGIC</span>
      <a class="item-create" data-type="spell" data-tooltip="Add Spell" style="color: #fff; cursor: pointer; font-size: 11px; font-weight: normal; text-transform: none;">
        <i class="fa-solid fa-plus"></i> Add Spell
      </a>
    </div>
    <table class="dcc-attacks-table">
      <thead>
        <tr>
          <th style="width: 25%;">Spell</th>
          <th style="width: 14%;">Cost / Stat</th>
          <th style="width: 20%;">Damage / Effect</th>
          <th style="width: 26%;">Range &amp; Details</th>
          <th style="width: 15%; text-align: center;">Actions</th>
        </tr>
      </thead>
      <tbody>
        {{#each spells as |spell|}}
          <tr data-item-id="{{spell.id}}" draggable="true">
            <td>
              <div style="display: flex; align-items: center; gap: 6px;">
                <img src="{{spell.img}}" width="20" height="20" style="border: none; border-radius: 2px;" />
                <a class="roll-spell" data-tooltip="Cast {{spell.name}}" style="font-weight: bold; cursor: pointer; color: #1a5276;">{{spell.name}}</a>
              </div>
            </td>
            <td>
              <span style="font-size: 11px; font-weight: bold; color: #1a5276;">{{spell.system.manaCost}} MP</span>
              <small style="color: #333333;">({{upper spell.system.stat}} {{spell.statModStr}})</small>
            </td>
            <td>
              {{#if spell.hasDamage}}
                <button type="button" class="dcc-attack-roll-btn roll-spell-dmg" data-tooltip="Roll Damage ({{spell.damageFormula}})" style="background: #c0392b; color: #fff; font-size: 10px; padding: 2px 6px;">
                  {{spell.damageDice}} {{spell.damageType}}
                </button>
              {{else}}
                <span style="font-size: 11px;">{{spell.system.spellType}}</span>
              {{/if}}
            </td>
            <td>
              <span style="font-size: 11px;">{{#if spell.system.range}}{{spell.system.range}} &bull; {{/if}}{{spell.system.description}}</span>
            </td>
            <td style="text-align: center; white-space: nowrap;">
              <button type="button" class="dcc-attack-roll-btn roll-spell" data-tooltip="Cast {{spell.name}}" style="font-size: 10px; padding: 2px 6px;">
                <i class="fa-solid fa-wand-magic-sparkles"></i> Cast
              </button>
              <a class="item-edit" data-tooltip="Edit Spell" style="margin-left: 3px; cursor: pointer;"><i class="fa-solid fa-edit"></i></a>
              <a class="item-delete" data-tooltip="Delete Spell" style="margin-left: 3px; cursor: pointer; color: #c0392b;"><i class="fa-solid fa-trash"></i></a>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{/if}}

  {{#if isMob}}
  {{!-- MOB TREASURE & LOOT DROPS (PAGE 1 COMBAT QUICK-ACCESS) --}}
  <div class="dcc-stat-block mob-loot-block" style="margin-top: 8px;">
    <div class="dcc-banner-header" style="display: flex; justify-content: space-between; align-items: center;">
      <span><i class="fa-solid fa-sack-dollar"></i> TREASURE &amp; LOOT DROPS</span>
      <a class="item-create" data-type="loot" data-tooltip="Add Loot Item" style="color: #fff; cursor: pointer; font-size: 11px; font-weight: normal; text-transform: none;">
        <i class="fa-solid fa-plus"></i> Add Loot
      </a>
    </div>
    <table class="dcc-attacks-table">
      <thead>
        <tr>
          <th style="width: 35%;">Item</th>
          <th style="width: 15%;">Quantity</th>
          <th style="width: 40%;">Description / Notes</th>
          <th style="width: 10%;">Actions</th>
        </tr>
      </thead>
      <tbody>
        {{#each loot as |item|}}
          <tr data-item-id="{{item.id}}" draggable="true">
            <td>
              <div style="display: flex; align-items: center; gap: 6px;">
                <img src="{{item.img}}" width="20" height="20" style="border: none; border-radius: 2px;" />
                <span style="font-weight: bold;">{{item.name}}</span>
              </div>
            </td>
            <td>
              <input class="dcc-stat-input item-inline-edit" type="number" data-field="system.quantity" value="{{item.system.quantity}}" style="width: 44px;" />
            </td>
            <td>
              <input class="dcc-field-input item-inline-edit" type="text" data-field="system.notes" value="{{#if item.system.notes}}{{item.system.notes}}{{else}}{{item.system.description}}{{/if}}" placeholder="Loot notes..." />
            </td>
            <td>
              <a class="item-use" data-tooltip="Use / Drop in Chat" style="color: #1a5276; cursor: pointer; margin-right: 6px;"><i class="fa-solid fa-box-open"></i></a>
              <a class="item-edit" data-tooltip="Edit"><i class="fa-solid fa-edit"></i></a>
              <a class="item-delete" data-tooltip="Delete" style="margin-left: 6px;"><i class="fa-solid fa-trash"></i></a>
            </td>
          </tr>
        {{else}}
          <tr>
            <td colspan="4" style="text-align: center; color: #333333; padding: 10px;">
              No loot items configured. Click <strong>Add Loot</strong> above or drop Loot items.
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{/if}}

  {{#if isMob}}
  {{!-- MOB LORE, AI BROADCAST & SPECIAL TRAITS --}}
  <div class="dcc-stat-block mob-lore-block" style="margin-top: 8px;">
    <div class="dcc-banner-header">
      <span><i class="fa-solid fa-scroll"></i> MOB LORE, AI BROADCAST &amp; SPECIAL TRAITS</span>
    </div>
    <div style="padding: 8px; display: flex; flex-direction: column; gap: 8px;">
      <div>
        <span class="dcc-field-label" style="display: block; margin-bottom: 2px; font-weight: bold; color: #2c3e50;">MOB DESCRIPTION</span>
        <textarea class="dcc-field-input" name="system.details.description" rows="3" placeholder="Mob visual description, characteristics, and biology...">{{system.details.description}}</textarea>
      </div>
      <div style="background: #fdf2f2; border: 1px solid #e74c3c; border-radius: 4px; padding: 6px 8px;">
        <span class="dcc-field-label" style="display: block; margin-bottom: 2px; font-weight: bold; color: #c0392b;"><i class="fa-solid fa-tower-broadcast"></i> DUNGEON AI ANNOUNCEMENT</span>
        <textarea class="dcc-field-input" name="system.details.aiDescription" rows="3" style="font-style: italic; color: #5c1d1d;" placeholder="Dungeon AI announcement quote...">{{system.details.aiDescription}}</textarea>
      </div>
      <div>
        <span class="dcc-field-label" style="display: block; margin-bottom: 2px; font-weight: bold; color: #2c3e50;">SPECIAL TRAITS &amp; RULES</span>
        <textarea class="dcc-field-input" name="system.details.special" rows="3" placeholder="Special immunities, vulnerabilities, passives, and unique mechanics...">{{system.details.special}}</textarea>
      </div>
      <div>
        <span class="dcc-field-label" style="display: block; margin-bottom: 2px; font-weight: bold; color: #2c3e50;">TACTICS &amp; GENERAL NOTES</span>
        <textarea class="dcc-field-input" name="system.details.notes" rows="3" placeholder="Mob behavior, positioning, combat sequence, and notes...">{{system.details.notes}}</textarea>
      </div>
    </div>
  </div>
  {{/if}}

  {{#unless isMob}}
  {{!-- HOTLIST (BOTTOM OF MAIN CHARACTER SHEET) --}}
  {{> "systems/carl-rpg/templates/actors/parts/hotlist.hbs"}}
  {{/unless}}
</div>
