        </div>
      </div>
      <div class="dcc-field-group" style="margin-bottom: 0;">
        <span class="dcc-field-label">Non-Defined Abilities / Milestone Notes</span>
        <input class="dcc-field-input" type="text" name="system.rankBreaks.rank20.notes" value="{{system.rankBreaks.rank20.notes}}" placeholder="e.g. God-tier milestone perk..." style="font-size: 11px;" />
      </div>
    </div>
  </div>
</details>

{{!-- SKILL DAMAGE MODIFIERS (RANK GATED) (COLLAPSIBLE WITH PROGRESSIVE DISCLOSURE) --}}
<details class="dcc-collapsible-block" {{#if hasDamageModifiersConfigured}}open{{/if}}>
  <summary class="dcc-collapsible-summary">
    <span class="dcc-collapsible-title"><i class="fa-solid fa-chevron-right dcc-chevron"></i> <i class="fa-solid fa-bolt"></i> ATTACK DAMAGE MODIFIERS (SCALING / PASSIVE)</span>
    <span class="dcc-toggle-indicator {{#if hasDamageModifiersConfigured}}active{{/if}}">{{#if hasDamageModifiersConfigured}}[DAMAGE MODS ({{system.damageModifiers.length}})]{{else}}[CLICK TO ADD DAMAGE MODS]{{/if}}</span>
  </summary>
  <div class="dcc-collapsible-content">
    <div style="display: flex; justify-content: flex-end; margin-bottom: 6px;">
      <a class="add-damage-mod" style="color: #2980b9; font-size: 11px; cursor: pointer; font-weight: bold;">
        <i class="fa-solid fa-plus"></i> Add Damage Bonus
      </a>
    </div>
    {{#if system.damageModifiers.length}}
      <table class="dcc-table" style="margin: 0; font-size: 11px;">
        <thead>
          <tr>
            <th style="width: 30%;">Damage Type</th>
            <th style="width: 20%;">Fixed Bonus</th>
            <th style="width: 25%;">Dice (Optional)</th>
            <th style="width: 20%;">Min Rank</th>
            <th style="width: 5%;"></th>
          </tr>
        </thead>
        <tbody>
          {{#each system.damageModifiers as |mod idx|}}
            <tr>
              <td>
                <select class="dcc-field-input" name="system.damageModifiers.{{idx}}.type" style="font-size: 11px;">
                  {{#each ../damageTypes as |dt|}}
                    <option value="{{dt}}" {{#if (eq mod.type dt)}}selected{{/if}}>{{dt}}</option>
                  {{/each}}
                </select>
              </td>
              <td>
                <input class="dcc-stat-input" type="number" name="system.damageModifiers.{{idx}}.value" value="{{mod.value}}" placeholder="2" style="width: 100%; font-size: 11px;" />
              </td>
              <td>
                <input class="dcc-field-input" type="text" name="system.damageModifiers.{{idx}}.dice" value="{{mod.dice}}" placeholder="1d4" style="width: 100%; font-size: 11px;" />
              </td>
              <td>
                <input class="dcc-stat-input" type="number" name="system.damageModifiers.{{idx}}.minRank" value="{{mod.minRank}}" placeholder="0" style="width: 100%; font-size: 11px;" />
              </td>
              <td style="text-align: center;">
                <a class="delete-damage-mod" data-index="{{idx}}" data-tooltip="Delete" style="color: #c0392b; cursor: pointer;"><i class="fa-solid fa-trash"></i></a>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    {{else}}
      <div style="text-align: center; font-style: italic; color: #333333; font-size: 11px; padding: 6px;">
        No attack damage bonuses. Click "Add Damage Bonus" above to add scaling or typed damage to attacks.
      </div>
    {{/if}}
  </div>
</details>

<div class="dcc-field-group" style="margin-bottom: 8px;">
  <span class="dcc-field-label">Notes & Upgrades</span>
  <textarea class="dcc-field-input" name="system.notes" style="height: 120px;">{{system.notes}}</textarea>
</div>
