<div class="dcc-field-row" style="margin-bottom: 8px; flex-wrap: wrap;">
  <div class="dcc-field-group small">
    <span class="dcc-field-label">Base Rank</span>
    <input class="dcc-field-input" type="number" name="system.rank" value="{{system.rank}}" />
  </div>
  <div class="dcc-field-group small">
    <span class="dcc-field-label">Boon Bonus</span>
    <input class="dcc-field-input" type="number" name="system.boonBonus" value="{{system.boonBonus}}" placeholder="0" />
  </div>
  <div class="dcc-field-group small">
    <span class="dcc-field-label">Item Bonus</span>
    <input class="dcc-field-input" type="number" name="system.itemBonus" value="{{system.itemBonus}}" placeholder="0" readonly title="Calculated from equipped gear" />
  </div>
  <div class="dcc-field-group small">
    <span class="dcc-field-label">Type Bonus</span>
    <input class="dcc-field-input" type="number" name="system.typeBonus" value="{{system.typeBonus}}" placeholder="0" readonly title="Calculated from generic weapon group skills or group gear modifiers" />
  </div>
  <div class="dcc-field-group small">
    <span class="dcc-field-label">Modified Rank</span>
    <input class="dcc-field-input" type="number" value="{{system.modifiedRank}}" readonly title="Base + Boon + Item + Type Bonus" style="font-weight: bold; background: #fff8e7; color: #c0392b;" />
  </div>
  <div class="dcc-field-group small">
    <span class="dcc-field-label">Skill Type</span>
    <select name="system.skillType" class="dcc-field-input">
      {{#if skillTypeOptions}}
        {{#each skillTypeOptions}}
          <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      {{else}}
        <option value="Edge" {{#if (eq (or system.skillType system.type) "Edge")}}selected{{/if}}>Edge</option>
        <option value="Bashing" {{#if (eq (or system.skillType system.type) "Bashing")}}selected{{/if}}>Bashing</option>
        <option value="Reach" {{#if (eq (or system.skillType system.type) "Reach")}}selected{{/if}}>Reach</option>
        <option value="Ranged" {{#if (eq (or system.skillType system.type) "Ranged")}}selected{{/if}}>Ranged</option>
        <option value="Strike" {{#if (eq (or system.skillType system.type) "Strike")}}selected{{/if}}>Strike</option>
        <option value="Hand to Hand" {{#if (eq (or system.skillType system.type) "Hand to Hand")}}selected{{/if}}>Hand to Hand</option>
        <option value="Utility" {{#if (eq (or system.skillType system.type) "Utility")}}selected{{/if}}>Utility</option>
      {{/if}}
    </select>
  </div>
  <div class="dcc-field-group small">
    <span class="dcc-field-label">Stat</span>
    <select name="system.stat" class="dcc-field-input">
      <option value="str" {{#if (eq system.stat "str")}}selected{{/if}}>STR</option>
      <option value="int" {{#if (eq system.stat "int")}}selected{{/if}}>INT</option>
      <option value="con" {{#if (eq system.stat "con")}}selected{{/if}}>CON</option>
      <option value="dex" {{#if (eq system.stat "dex")}}selected{{/if}}>DEX</option>
      <option value="cha" {{#if (eq system.stat "cha")}}selected{{/if}}>CHA</option>
    </select>
  </div>
  <div class="dcc-field-group">
    <span class="dcc-field-label">Check Type</span>
    <input class="dcc-field-input" type="text" name="system.checkType" value="{{system.checkType}}" placeholder="Stat Check" />
  </div>
</div>

<div class="dcc-field-row" style="margin-bottom: 8px; flex-wrap: wrap; align-items: center; gap: 8px;">
  <div class="dcc-field-group small">
    <span class="dcc-field-label">Category</span>
    <select name="system.category" class="dcc-field-input">
      <option value="Utility" {{#if (eq system.category "Utility")}}selected{{/if}}>Utility</option>
      <option value="Combat" {{#if (eq system.category "Combat")}}selected{{/if}}>Combat</option>
      <option value="Tactical" {{#if (eq system.category "Tactical")}}selected{{/if}}>Tactical</option>
      <option value="Defensive" {{#if (eq system.category "Defensive")}}selected{{/if}}>Defensive</option>
      <option value="Buff" {{#if (eq system.category "Buff")}}selected{{/if}}>Buff</option>
      <option value="Debuff" {{#if (eq system.category "Debuff")}}selected{{/if}}>Debuff</option>
      <option value="General" {{#if (eq system.category "General")}}selected{{/if}}>General</option>
    </select>
  </div>
  <div class="dcc-field-group" style="flex: 2;">
    <span class="dcc-field-label">Base Damage Formula</span>
    <input class="dcc-field-input" type="text" name="system.baseDamage" value="{{system.baseDamage}}" placeholder="e.g. 1d8 + Str Piercing" />
  </div>
  <div class="dcc-field-group" style="display: flex; flex-direction: row; align-items: center; gap: 12px; margin-top: 14px;">
    <label style="display: flex; align-items: center; gap: 4px; font-size: 11px; cursor: pointer;" title="Check if this skill is an attack action that targets enemies and rolls to hit">
      <input type="checkbox" name="system.isAttack" {{#if system.isAttack}}checked{{/if}} />
      <strong>Is Attack Action</strong>
    </label>
    <label style="display: flex; align-items: center; gap: 4px; font-size: 11px; cursor: pointer;" title="Check if this skill inflicts direct damage">
      <input type="checkbox" name="system.hasDamage" {{#if system.hasDamage}}checked{{/if}} />
      <strong>Deals Damage</strong>
    </label>
  </div>
</div>

{{!-- WEAPON PROFICIENCY, TECHNIQUES & SPECIAL CONDITIONS (COLLAPSIBLE WITH PROGRESSIVE DISCLOSURE) --}}
<details class="dcc-collapsible-block" {{#if hasTechniqueConfigured}}open{{/if}}>
  <summary class="dcc-collapsible-summary">
    <span class="dcc-collapsible-title"><i class="fa-solid fa-chevron-right dcc-chevron"></i> <i class="fa-solid fa-wand-magic-sparkles"></i> TECHNIQUES, CONDITIONS & CRITICAL MILESTONES</span>
    <span class="dcc-toggle-indicator {{#if hasTechniqueConfigured}}active{{/if}}">{{#if hasTechniqueConfigured}}[TECHNIQUE / CRIT CONFIGURED]{{else}}[CLICK TO CONFIGURE TECHNIQUES / CRITS]{{/if}}</span>
  </summary>
  <div class="dcc-collapsible-content">
    <div class="dcc-field-row" style="margin-bottom: 6px; align-items: center; gap: 8px;">
      <label style="display: flex; align-items: center; gap: 4px; font-weight: bold; font-size: 11px; cursor: pointer; color: #2c3e50;">
        <input type="checkbox" name="system.isTechnique" {{#if system.isTechnique}}checked{{/if}} />
        <span>Is Combat Technique / Damage Maneuver</span>
      </label>
    </div>
    {{#if system.isTechnique}}
      <div class="dcc-field-row" style="margin-bottom: 6px; align-items: center; gap: 12px;">
        <label style="display: flex; align-items: center; gap: 4px; font-size: 11px; cursor: pointer;">
          <input type="checkbox" name="system.techniqueConfig.isDamageEffect" {{#if system.techniqueConfig.isDamageEffect}}checked{{/if}} />
          <strong>Functions as Optional Damage Effect / Attack Maneuver</strong>
        </label>
      </div>
      <div class="dcc-field-row" style="margin-bottom: 6px;">
        <div class="dcc-field-group" style="flex: 2;">
          <span class="dcc-field-label">Applies To (Weapons / Skills / Tags)</span>
          <input class="dcc-field-input" type="text" name="system.appliesTo" value="{{appliesToString}}" placeholder="e.g. Chainsaw, Power Weapons, Pugilism, unarmed" style="font-size: 11px;" />
        </div>
        <div class="dcc-field-group" style="flex: 1;">
          <span class="dcc-field-label">Base Dice Count Mod</span>
          <input class="dcc-field-input" type="text" name="system.techniqueConfig.baseDiceCountMod" value="{{system.techniqueConfig.baseDiceCountMod}}" placeholder="e.g. +1 or * @rank" style="font-size: 11px;" />
        </div>
        <div class="dcc-field-group" style="flex: 1;">
          <span class="dcc-field-label">Flat Damage Mod</span>
          <input class="dcc-field-input" type="text" name="system.techniqueConfig.flatDamageMod" value="{{system.techniqueConfig.flatDamageMod}}" placeholder="e.g. + @rank" style="font-size: 11px;" />
        </div>
      </div>
      <div class="dcc-field-row" style="margin-bottom: 6px;">
        <div class="dcc-field-group" style="flex: 1;">
          <span class="dcc-field-label">Technique Damage Bonus</span>
          <input class="dcc-field-input" type="text" name="system.techniqueConfig.damageBonus" value="{{system.techniqueConfig.damageBonus}}" placeholder="e.g. +2d4 or 1d8" style="font-size: 11px;" />
        </div>
        <div class="dcc-field-group" style="flex: 1;">
          <span class="dcc-field-label">Bonus Damage Type</span>
          <select class="dcc-field-input" name="system.techniqueConfig.damageType" style="font-size: 11px;">
            <option value="">-- Match Weapon --</option>
            {{#each damageTypes as |dt|}}
              <option value="{{dt}}" {{#if (eq ../system.techniqueConfig.damageType dt)}}selected{{/if}}>{{dt}}</option>
            {{/each}}
          </select>
        </div>
        <div class="dcc-field-group" style="flex: 1;">
          <span class="dcc-field-label">On-Use Target Debuff</span>
          <select class="dcc-field-input" name="system.techniqueConfig.debuffName" style="font-size: 11px;">
            <option value="">-- None --</option>
            {{#each availableDebuffs as |deb|}}
              <option value="{{deb.name}}" {{#if (eq ../system.techniqueConfig.debuffName deb.name)}}selected{{/if}}>{{deb.name}}</option>
            {{/each}}
          </select>
        </div>
        <div class="dcc-field-group" style="flex: 1;">
          <span class="dcc-field-label">Cooldown</span>
          <input class="dcc-field-input" type="text" name="system.techniqueConfig.cooldown" value="{{system.techniqueConfig.cooldown}}" placeholder="e.g. 30 hours, 1/round" style="font-size: 11px;" />
        </div>
      </div>
    {{/if}}

    <div class="dcc-field-row" style="margin-bottom: 6px;">
      <div class="dcc-field-group">
        <span class="dcc-field-label"><i class="fa-solid fa-burst" style="color: #c0392b;"></i> Rank 5 Crit Multiplier</span>
        <input class="dcc-field-input" type="number" name="system.critMultiplierR5" value="{{#if system.critMultiplierR5}}{{system.critMultiplierR5}}{{else}}1{{/if}}" placeholder="1" style="font-size: 11px;" />
      </div>
      <div class="dcc-field-group">
        <span class="dcc-field-label"><i class="fa-solid fa-skull" style="color: #c0392b;"></i> Rank 15 Crit Multiplier</span>
        <input class="dcc-field-input" type="number" name="system.critMultiplierR15" value="{{#if system.critMultiplierR15}}{{system.critMultiplierR15}}{{else}}1{{/if}}" placeholder="1" style="font-size: 11px;" />
      </div>
      <div class="dcc-field-group">
        <span class="dcc-field-label"><i class="fa-solid fa-triangle-exclamation" style="color: #873600;"></i> Fumble Consequence (Self Debuff)</span>
        <select class="dcc-field-input" name="system.fumbleDebuff" style="font-size: 11px;">
          <option value="">-- None --</option>
          {{#each availableDebuffs as |deb|}}
            <option value="{{deb.name}}" {{#if (eq ../system.fumbleDebuff deb.name)}}selected{{/if}}>{{deb.name}}</option>
          {{/each}}
        </select>
      </div>
    </div>

    <div class="dcc-field-row">
      <div class="dcc-field-group" style="flex: 2;">
        <span class="dcc-field-label"><i class="fa-solid fa-droplet" style="color: #c0392b;"></i> On-Hit Debuff Trigger</span>
        <select class="dcc-field-input" name="system.onHitDebuff" style="font-size: 11px;">
          <option value="">-- None --</option>
          {{#each availableDebuffs as |deb|}}
            <option value="{{deb.name}}" {{#if (eq ../system.onHitDebuff deb.name)}}selected{{/if}}>{{deb.name}}</option>
          {{/each}}
        </select>
      </div>
      <div class="dcc-field-group" style="flex: 1;">
        <span class="dcc-field-label">Min Rank to Inflict</span>
        <input class="dcc-field-input" type="number" name="system.onHitDebuffMinRank" value="{{system.onHitDebuffMinRank}}" placeholder="10" style="font-size: 11px;" />
      </div>
    </div>
  </div>
</details>

{{!-- RANK MILESTONES & BREAK CONFIGURATIONS (RANKS 5, 10, 15, 20) (COLLAPSIBLE WITH PROGRESSIVE DISCLOSURE) --}}
<details class="dcc-collapsible-block" {{#if hasRankBreaksConfigured}}open{{/if}}>
  <summary class="dcc-collapsible-summary">
    <span class="dcc-collapsible-title"><i class="fa-solid fa-chevron-right dcc-chevron"></i> <i class="fa-solid fa-layer-group"></i> RANK BREAK CONFIGURATIONS (RANKS 5, 10, 15, 20)</span>
    <span class="dcc-toggle-indicator {{#if hasRankBreaksConfigured}}active{{/if}}">{{#if hasRankBreaksConfigured}}[RANK BREAKS CONFIGURED]{{else}}[CLICK TO CONFIGURE RANK BREAKS]{{/if}}</span>
