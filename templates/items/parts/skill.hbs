<div class="dcc-field-row" style="margin-bottom: 8px; flex-wrap: wrap;">
  <div class="dcc-field-group small">
    <span class="dcc-field-label">Base Rank</span>
    <input class="dcc-field-input" type="number" name="system.rank" value="{{system.rank}}" />
  </div>
  <div class="dcc-field-group small">
    <span class="dcc-field-label">Boon Bonus</span>
    <input class="dcc-field-input" type="number" name="system.boonBonus" value="{{system.boonBonus}}" placeholder="0" />
  </div>
  <div class="dcc-field-group small">
    <span class="dcc-field-label">Item Bonus</span>
    <input class="dcc-field-input" type="number" name="system.itemBonus" value="{{system.itemBonus}}" placeholder="0" readonly title="Calculated from equipped gear" />
  </div>
  <div class="dcc-field-group small">
    <span class="dcc-field-label">Type Bonus</span>
    <input class="dcc-field-input" type="number" name="system.typeBonus" value="{{system.typeBonus}}" placeholder="0" readonly title="Calculated from generic weapon group skills or group gear modifiers" />
  </div>
  <div class="dcc-field-group small">
    <span class="dcc-field-label">Modified Rank</span>
    <input class="dcc-field-input" type="number" value="{{system.modifiedRank}}" readonly title="Base + Boon + Item + Type Bonus" style="font-weight: bold; background: #fff8e7; color: #c0392b;" />
  </div>
  <div class="dcc-field-group small">
    <span class="dcc-field-label">Skill Type</span>
    <select name="system.skillType" class="dcc-field-input">
      {{#if skillTypeOptions}}
        {{#each skillTypeOptions}}
          <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      {{else}}
        <option value="Edge" {{#if (eq (or system.skillType system.type) "Edge")}}selected{{/if}}>Edge</option>
        <option value="Bashing" {{#if (eq (or system.skillType system.type) "Bashing")}}selected{{/if}}>Bashing</option>
        <option value="Reach" {{#if (eq (or system.skillType system.type) "Reach")}}selected{{/if}}>Reach</option>
        <option value="Ranged" {{#if (eq (or system.skillType system.type) "Ranged")}}selected{{/if}}>Ranged</option>
        <option value="Strike" {{#if (eq (or system.skillType system.type) "Strike")}}selected{{/if}}>Strike</option>
        <option value="Hand to Hand" {{#if (eq (or system.skillType system.type) "Hand to Hand")}}selected{{/if}}>Hand to Hand</option>
        <option value="Utility" {{#if (eq (or system.skillType system.type) "Utility")}}selected{{/if}}>Utility</option>
      {{/if}}
    </select>
  </div>
  <div class="dcc-field-group small">
    <span class="dcc-field-label">Stat</span>
    <select name="system.stat" class="dcc-field-input">
      <option value="str" {{#if (eq system.stat "str")}}selected{{/if}}>STR</option>
      <option value="int" {{#if (eq system.stat "int")}}selected{{/if}}>INT</option>
      <option value="con" {{#if (eq system.stat "con")}}selected{{/if}}>CON</option>
      <option value="dex" {{#if (eq system.stat "dex")}}selected{{/if}}>DEX</option>
      <option value="cha" {{#if (eq system.stat "cha")}}selected{{/if}}>CHA</option>
    </select>
  </div>
  <div class="dcc-field-group">
    <span class="dcc-field-label">Check Type</span>
    <input class="dcc-field-input" type="text" name="system.checkType" value="{{system.checkType}}" placeholder="Stat Check" />
  </div>
</div>

<div class="dcc-field-row" style="margin-bottom: 8px; flex-wrap: wrap; align-items: center; gap: 8px;">
  <div class="dcc-field-group small">
    <span class="dcc-field-label">Category</span>
    <select name="system.category" class="dcc-field-input">
      <option value="Utility" {{#if (eq system.category "Utility")}}selected{{/if}}>Utility</option>
      <option value="Combat" {{#if (eq system.category "Combat")}}selected{{/if}}>Combat</option>
      <option value="Tactical" {{#if (eq system.category "Tactical")}}selected{{/if}}>Tactical</option>
      <option value="Defensive" {{#if (eq system.category "Defensive")}}selected{{/if}}>Defensive</option>
      <option value="Buff" {{#if (eq system.category "Buff")}}selected{{/if}}>Buff</option>
      <option value="Debuff" {{#if (eq system.category "Debuff")}}selected{{/if}}>Debuff</option>
      <option value="General" {{#if (eq system.category "General")}}selected{{/if}}>General</option>
    </select>
  </div>
  <div class="dcc-field-group" style="flex: 2;">
    <span class="dcc-field-label">Base Damage Formula</span>
    <input class="dcc-field-input" type="text" name="system.baseDamage" value="{{system.baseDamage}}" placeholder="e.g. 1d8 + Str Piercing" />
  </div>
  <div class="dcc-field-group" style="display: flex; flex-direction: row; align-items: center; gap: 12px; margin-top: 14px;">
    <label style="display: flex; align-items: center; gap: 4px; font-size: 11px; cursor: pointer;" title="Check if this skill is an attack action that targets enemies and rolls to hit">
      <input type="checkbox" name="system.isAttack" {{#if system.isAttack}}checked{{/if}} />
      <strong>Is Attack Action</strong>
    </label>
    <label style="display: flex; align-items: center; gap: 4px; font-size: 11px; cursor: pointer;" title="Check if this skill inflicts direct damage">
      <input type="checkbox" name="system.hasDamage" {{#if system.hasDamage}}checked{{/if}} />
      <strong>Deals Damage</strong>
    </label>
  </div>
</div>

{{!-- WEAPON PROFICIENCY, TECHNIQUES & SPECIAL CONDITIONS (COLLAPSIBLE WITH PROGRESSIVE DISCLOSURE) --}}
<details class="dcc-collapsible-block" {{#if hasTechniqueConfigured}}open{{/if}}>
  <summary class="dcc-collapsible-summary">
    <span class="dcc-collapsible-title"><i class="fa-solid fa-chevron-right dcc-chevron"></i> <i class="fa-solid fa-wand-magic-sparkles"></i> TECHNIQUES, CONDITIONS & CRITICAL MILESTONES</span>
    <span class="dcc-toggle-indicator {{#if hasTechniqueConfigured}}active{{/if}}">{{#if hasTechniqueConfigured}}[TECHNIQUE / CRIT CONFIGURED]{{else}}[CLICK TO CONFIGURE TECHNIQUES / CRITS]{{/if}}</span>
  </summary>
  <div class="dcc-collapsible-content">
    <div class="dcc-field-row" style="margin-bottom: 6px; align-items: center; gap: 8px;">
      <label style="display: flex; align-items: center; gap: 4px; font-weight: bold; font-size: 11px; cursor: pointer; color: #2c3e50;">
        <input type="checkbox" name="system.isTechnique" {{#if system.isTechnique}}checked{{/if}} />
        <span>Is Combat Technique / Damage Maneuver</span>
      </label>
    </div>
    {{#if system.isTechnique}}
      <div class="dcc-field-row" style="margin-bottom: 6px; align-items: center; gap: 12px;">
        <label style="display: flex; align-items: center; gap: 4px; font-size: 11px; cursor: pointer;">
          <input type="checkbox" name="system.techniqueConfig.isDamageEffect" {{#if system.techniqueConfig.isDamageEffect}}checked{{/if}} />
          <strong>Functions as Optional Damage Effect / Attack Maneuver</strong>
        </label>
      </div>
      <div class="dcc-field-row" style="margin-bottom: 6px;">
        <div class="dcc-field-group" style="flex: 2;">
          <span class="dcc-field-label">Applies To (Weapons / Skills / Tags)</span>
          <input class="dcc-field-input" type="text" name="system.appliesTo" value="{{appliesToString}}" placeholder="e.g. Chainsaw, Power Weapons, Pugilism, unarmed" style="font-size: 11px;" />
        </div>
        <div class="dcc-field-group" style="flex: 1;">
          <span class="dcc-field-label">Base Dice Count Mod</span>
          <input class="dcc-field-input" type="text" name="system.techniqueConfig.baseDiceCountMod" value="{{system.techniqueConfig.baseDiceCountMod}}" placeholder="e.g. +1 or * @rank" style="font-size: 11px;" />
        </div>
        <div class="dcc-field-group" style="flex: 1;">
          <span class="dcc-field-label">Flat Damage Mod</span>
          <input class="dcc-field-input" type="text" name="system.techniqueConfig.flatDamageMod" value="{{system.techniqueConfig.flatDamageMod}}" placeholder="e.g. + @rank" style="font-size: 11px;" />
        </div>
      </div>
      <div class="dcc-field-row" style="margin-bottom: 6px;">
        <div class="dcc-field-group" style="flex: 1;">
          <span class="dcc-field-label">Technique Damage Bonus</span>
          <input class="dcc-field-input" type="text" name="system.techniqueConfig.damageBonus" value="{{system.techniqueConfig.damageBonus}}" placeholder="e.g. +2d4 or 1d8" style="font-size: 11px;" />
        </div>
        <div class="dcc-field-group" style="flex: 1;">
          <span class="dcc-field-label">Bonus Damage Type</span>
          <select class="dcc-field-input" name="system.techniqueConfig.damageType" style="font-size: 11px;">
            <option value="">-- Match Weapon --</option>
            {{#each damageTypes as |dt|}}
              <option value="{{dt}}" {{#if (eq ../system.techniqueConfig.damageType dt)}}selected{{/if}}>{{dt}}</option>
            {{/each}}
          </select>
        </div>
        <div class="dcc-field-group" style="flex: 1;">
          <span class="dcc-field-label">On-Use Target Debuff</span>
          <select class="dcc-field-input" name="system.techniqueConfig.debuffName" style="font-size: 11px;">
            <option value="">-- None --</option>
            {{#each availableDebuffs as |deb|}}
              <option value="{{deb.name}}" {{#if (eq ../system.techniqueConfig.debuffName deb.name)}}selected{{/if}}>{{deb.name}}</option>
            {{/each}}
          </select>
        </div>
        <div class="dcc-field-group" style="flex: 1;">
          <span class="dcc-field-label">Cooldown</span>
          <input class="dcc-field-input" type="text" name="system.techniqueConfig.cooldown" value="{{system.techniqueConfig.cooldown}}" placeholder="e.g. 30 hours, 1/round" style="font-size: 11px;" />
        </div>
        <div class="dcc-field-group small" style="text-align: center; max-width: 90px;">
          <span class="dcc-field-label">Armor Pierce</span>
          <label style="display: flex; align-items: center; justify-content: center; height: 28px; cursor: pointer;" title="Check if this technique penetrates armor and ignores Damage Resistance (DR)">
            <input type="checkbox" name="system.techniqueConfig.isArmorPiercing" {{#if system.techniqueConfig.isArmorPiercing}}checked{{/if}} style="width: 18px; height: 18px; cursor: pointer;" />
          </label>
        </div>
      </div>
    {{/if}}

    <div class="dcc-field-row" style="margin-bottom: 6px;">
      <div class="dcc-field-group" style="flex: 1;">
        <span class="dcc-field-label"><i class="fa-solid fa-triangle-exclamation" style="color: #873600;"></i> Fumble Consequence (Self Debuff)</span>
        <select class="dcc-field-input" name="system.fumbleDebuff" style="font-size: 11px;">
          <option value="">-- None --</option>
          {{#each availableDebuffs as |deb|}}
            <option value="{{deb.name}}" {{#if (eq ../system.fumbleDebuff deb.name)}}selected{{/if}}>{{deb.name}}</option>
          {{/each}}
        </select>
      </div>
      <div class="dcc-field-group" style="flex: 2;">
        <span class="dcc-field-label" style="color: #555; font-style: italic;">
          <i class="fa-solid fa-info-circle"></i> Critical Hit Multipliers
        </span>
        <div style="font-size: 11px; color: #666; padding-top: 4px;">
          Configured directly per milestone break below (selectable Ranks 1–20).
        </div>
      </div>
    </div>

    <div class="dcc-field-row">
      <div class="dcc-field-group" style="flex: 2;">
        <span class="dcc-field-label"><i class="fa-solid fa-droplet" style="color: #c0392b;"></i> On-Hit Debuff Trigger</span>
        <select class="dcc-field-input" name="system.onHitDebuff" style="font-size: 11px;">
          <option value="">-- None --</option>
          {{#each availableDebuffs as |deb|}}
            <option value="{{deb.name}}" {{#if (eq ../system.onHitDebuff deb.name)}}selected{{/if}}>{{deb.name}}</option>
          {{/each}}
        </select>
      </div>
      <div class="dcc-field-group" style="flex: 1;">
        <span class="dcc-field-label">Min Rank to Inflict</span>
        <input class="dcc-field-input" type="number" name="system.onHitDebuffMinRank" value="{{system.onHitDebuffMinRank}}" placeholder="10" style="font-size: 11px;" />
      </div>
    </div>
  </div>
</details>

{{!-- HEALING, HEALTH BARS & CLEANSING CONFIGURATION (COLLAPSIBLE WITH PROGRESSIVE DISCLOSURE) --}}
<details class="dcc-collapsible-block" {{#if hasHealingConfigured}}open{{/if}}>
  <summary class="dcc-collapsible-summary" style="background: #1e8449;">
    <span class="dcc-collapsible-title"><i class="fa-solid fa-chevron-right dcc-chevron"></i> <i class="fa-solid fa-heart-pulse"></i> HEALING, HEALTH BARS & CLEANSING CONFIGURATION</span>
    <span class="dcc-toggle-indicator {{#if hasHealingConfigured}}active{{/if}}">{{#if hasHealingConfigured}}[HEALING CONFIGURED]{{else}}[CLICK TO CONFIGURE HEALING / CLEANSING]{{/if}}</span>
  </summary>
  <div class="dcc-collapsible-content">
    <div class="dcc-field-row" style="margin-bottom: 6px; align-items: center; gap: 8px; flex-wrap: wrap;">
      <label style="display: flex; align-items: center; gap: 4px; font-weight: bold; font-size: 11px; cursor: pointer; color: #1e8449;">
        <input type="checkbox" name="system.healing.hasHealing" {{#if system.healing.hasHealing}}checked{{/if}} style="width: 16px; height: 16px;" />
        <span>Restores Health Bars</span>
      </label>
      <div class="dcc-field-group small" style="flex: 1;">
        <span class="dcc-field-label">Bars Formula</span>
        <input class="dcc-field-input" type="text" name="system.healing.barsFormula" value="{{#if system.healing.barsFormula}}{{system.healing.barsFormula}}{{else}}1{{/if}}" placeholder="1 or 1 + con" style="font-size: 11px; font-weight: bold;" />
      </div>
      <div class="dcc-field-group small" style="flex: 1;">
        <span class="dcc-field-label">Target Filter</span>
        <select class="dcc-field-input" name="system.healing.targetFilter" style="font-size: 11px;">
          <option value="allies" {{#if (eq system.healing.targetFilter "allies")}}selected{{/if}}>Allies</option>
          <option value="self" {{#if (eq system.healing.targetFilter "self")}}selected{{/if}}>Self Only</option>
          <option value="all" {{#if (eq system.healing.targetFilter "all")}}selected{{/if}}>Any Target</option>
        </select>
      </div>
      <label style="display: flex; align-items: center; gap: 4px; font-weight: bold; font-size: 11px; cursor: pointer; color: #2980b9;">
        <input type="checkbox" name="system.healing.isHoT" {{#if system.healing.isHoT}}checked{{/if}} style="width: 16px; height: 16px;" />
        <span>Heal Over Time (HoT)</span>
      </label>
      <div class="dcc-field-group small" style="width: 80px;">
        <span class="dcc-field-label">HoT Rounds</span>
        <input class="dcc-field-input" type="number" name="system.healing.hotRounds" value="{{#if system.healing.hotRounds}}{{system.healing.hotRounds}}{{else}}3{{/if}}" min="1" style="font-size: 11px;" />
      </div>
    </div>
    <div class="dcc-field-row" style="margin-bottom: 0;">
      <div class="dcc-field-group" style="flex: 1;">
        <span class="dcc-field-label"><i class="fa-solid fa-sparkles" style="color: #16a085;"></i> Cleanse Debuffs (Comma-separated debuff names to cure, e.g. Poisoned, Bleeding, Burned)</span>
        <input class="dcc-field-input" type="text" name="system.healing.cleanseDebuffs" value="{{cleanseDebuffsString}}" placeholder="Poisoned, Bleeding, Burned" style="font-size: 11px;" />
      </div>
    </div>
  </div>
</details>

{{!-- AURA & AREA OF EFFECT CONFIGURATION (COLLAPSIBLE WITH PROGRESSIVE DISCLOSURE) --}}
<details class="dcc-collapsible-block" {{#if hasAuraConfigured}}open{{/if}}>
  <summary class="dcc-collapsible-summary">
    <span class="dcc-collapsible-title"><i class="fa-solid fa-chevron-right dcc-chevron"></i> <i class="fa-solid fa-circle-notch"></i> AURA & AREA OF EFFECT CONFIGURATION</span>
    <span class="dcc-toggle-indicator {{#if hasAuraConfigured}}active{{/if}}">{{#if hasAuraConfigured}}[AURA / AOE CONFIGURED]{{else}}[CLICK TO CONFIGURE AURA / AOE]{{/if}}</span>
  </summary>
  <div class="dcc-collapsible-content">

    {{!-- Enable Aura Toggle & Scope --}}
    <div class="dcc-field-row" style="margin-bottom: 6px; align-items: center; gap: 8px; flex-wrap: wrap;">
      <label style="display: flex; align-items: center; gap: 4px; font-weight: bold; font-size: 11px; cursor: pointer; color: #2c3e50;">
        <input type="checkbox" name="system.area.hasArea" {{#if system.area.hasArea}}checked{{/if}} />
        <span>Emits Aura / Area Effect</span>
      </label>
      <div class="dcc-field-group small" style="flex: 1;">
        <span class="dcc-field-label">Shape</span>
        <select class="dcc-field-input" name="system.area.shape" style="font-size: 11px;">
          <option value="burst" {{#if (eq system.area.shape "burst")}}selected{{/if}}>Burst / Circle</option>
          <option value="cone" {{#if (eq system.area.shape "cone")}}selected{{/if}}>Cone</option>
          <option value="line" {{#if (eq system.area.shape "line")}}selected{{/if}}>Line</option>
        </select>
      </div>
      <div class="dcc-field-group small" style="flex: 1;">
        <span class="dcc-field-label">Base Radius (ft)</span>
        <input class="dcc-field-input" type="number" name="system.area.radius" value="{{system.area.radius}}" placeholder="5" min="0" style="font-size: 11px; font-weight: bold;" />
      </div>
      <div class="dcc-field-group small" style="flex: 1.2;">
        <span class="dcc-field-label">Origin / Delivery</span>
        <select class="dcc-field-input" name="system.area.origin" style="font-size: 11px;">
          <option value="caster" {{#if (eq system.area.origin "caster")}}selected{{/if}}>Self / User (Mobile Aura)</option>
          <option value="placed" {{#if (eq system.area.origin "placed")}}selected{{/if}}>Placed (Stationary Zone)</option>
        </select>
      </div>
      <div class="dcc-field-group small" style="flex: 1.2;">
        <span class="dcc-field-label">Target Filter</span>
        <select class="dcc-field-input" name="system.area.targetFilter" style="font-size: 11px;">
          <option value="allies" {{#if (eq system.area.targetFilter "allies")}}selected{{/if}}>Allies Only</option>
          <option value="enemies" {{#if (eq system.area.targetFilter "enemies")}}selected{{/if}}>Enemies Only</option>
          <option value="both" {{#if (eq system.area.targetFilter "both")}}selected{{/if}}>Both (Allies & Enemies)</option>
        </select>
      </div>
    </div>

    {{!-- Allied Protection / Temp Health Bars Sub-Block --}}
    <div class="dcc-rank-break-card" style="margin-bottom: 6px; border: 1px solid #ddd; border-left: 4px solid #196f3d; background: #fff; padding: 6px; border-radius: 3px;">
      <div style="font-weight: bold; font-size: 11px; color: #196f3d; margin-bottom: 4px; display: flex; align-items: center; justify-content: space-between;">
        <span><i class="fa-solid fa-shield-halved"></i> Allied Protection & Temporary Health Bars</span>
        <label style="font-size: 10px; font-weight: normal; color: #333; display: flex; align-items: center; gap: 4px; cursor: pointer;">
          <input type="checkbox" name="system.tempBars.hasTempBars" {{#if system.tempBars.hasTempBars}}checked{{/if}} />
          <span>Enable Bonus Health Bars</span>
        </label>
      </div>
      <div class="dcc-field-row" style="gap: 6px;">
        <div class="dcc-field-group" style="flex: 1.5;">
          <span class="dcc-field-label">Bar Slots Formula / Stat</span>
          <select class="dcc-field-input" name="system.tempBars.slotsFormula" style="font-size: 11px;">
            <option value="con" {{#if (eq system.tempBars.slotsFormula "con")}}selected{{/if}}>CON Mod</option>
            <option value="str" {{#if (eq system.tempBars.slotsFormula "str")}}selected{{/if}}>STR Mod</option>
            <option value="dex" {{#if (eq system.tempBars.slotsFormula "dex")}}selected{{/if}}>DEX Mod</option>
            <option value="cha" {{#if (eq system.tempBars.slotsFormula "cha")}}selected{{/if}}>CHA Mod</option>
            <option value="int" {{#if (eq system.tempBars.slotsFormula "int")}}selected{{/if}}>INT Mod</option>
            <option value="1" {{#if (eq system.tempBars.slotsFormula "1")}}selected{{/if}}>Fixed 1 Bar</option>
            <option value="2" {{#if (eq system.tempBars.slotsFormula "2")}}selected{{/if}}>Fixed 2 Bars</option>
          </select>
        </div>
        <div class="dcc-field-group" style="flex: 1;">
          <span class="dcc-field-label">Base HP Per Bar</span>
          <input class="dcc-field-input" type="number" name="system.tempBars.hpPerSlot" value="{{system.tempBars.hpPerSlot}}" placeholder="2" min="0" style="font-size: 11px;" />
        </div>
        <div class="dcc-field-group" style="flex: 1.5;">
          <span class="dcc-field-label">Elemental Damage Absorption</span>
          <select class="dcc-field-input" name="system.area.absorbElement" style="font-size: 11px;">
            <option value="">-- None / General Absorption --</option>
            {{#each damageTypes as |dt|}}
              <option value="{{dt}}" {{#if (eq ../system.area.absorbElement dt)}}selected{{/if}}>{{dt}}</option>
            {{/each}}
          </select>
        </div>
      </div>
    </div>

    {{!-- Enemy Hazard / Periodic Aura Damage Sub-Block --}}
    <div class="dcc-rank-break-card" style="border: 1px solid #ddd; border-left: 4px solid #c0392b; background: #fff; padding: 6px; border-radius: 3px;">
      <div style="font-weight: bold; font-size: 11px; color: #c0392b; margin-bottom: 4px; display: flex; align-items: center; justify-content: space-between;">
        <span><i class="fa-solid fa-burst"></i> Enemy Hazard (Periodic Damage & Debuffs in Radius)</span>
        <label style="font-size: 10px; font-weight: normal; color: #333; display: flex; align-items: center; gap: 4px; cursor: pointer;">
          <input type="checkbox" name="system.area.hasPeriodicDamage" {{#if system.area.hasPeriodicDamage}}checked{{/if}} />
          <span>Enable Periodic Aura Damage</span>
        </label>
      </div>
      <div class="dcc-field-row" style="gap: 6px;">
        <div class="dcc-field-group" style="flex: 1;">
          <span class="dcc-field-label">Tick Damage Formula</span>
          <input class="dcc-field-input" type="text" name="system.area.periodicDamageFormula" value="{{system.area.periodicDamageFormula}}" placeholder="e.g. 1d6" style="font-size: 11px;" />
        </div>
        <div class="dcc-field-group" style="flex: 1;">
          <span class="dcc-field-label">Damage Element</span>
          <select class="dcc-field-input" name="system.area.periodicDamageType" style="font-size: 11px;">
            <option value="">-- Damage Type --</option>
            {{#each damageTypes as |dt|}}
              <option value="{{dt}}" {{#if (eq ../system.area.periodicDamageType dt)}}selected{{/if}}>{{dt}}</option>
            {{/each}}
          </select>
        </div>
        <div class="dcc-field-group" style="flex: 1.5;">
          <span class="dcc-field-label">Inflict Debuff in Radius</span>
          <select class="dcc-field-input" name="system.area.inflictDebuff" style="font-size: 11px;">
            <option value="">-- None --</option>
            {{#each availableDebuffs as |deb|}}
              <option value="{{deb.name}}" {{#if (eq ../system.area.inflictDebuff deb.name)}}selected{{/if}}>{{deb.name}}</option>
            {{/each}}
          </select>
        </div>
      </div>
    </div>

