{
  "id": "carl-rpg",
  "title": "Dungeon Crawler Carl RPG",
  "description": "A Zippy versioned Foundry VTT system for the Dungeon Crawler Carl Roleplaying Game.",
  "version": "3.2.3.1",
  "url": "https://github.com/zippydebug/carlrpg",
  "manifest": "https://raw.githubusercontent.com/zippydebug/carlrpg/main/system.json",
  "download": "https://github.com/zippydebug/carlrpg/archive/refs/heads/main.zip",
  "compatibility": {
    "minimum": "12",
    "verified": "14",
    "maximum": "16"
  },
  "documentTypes": {
    "Actor": {
      "crawler": {
        "htmlFields": [
          "details.notes",
          "details.pastTrauma",
          "details.looseEnds",
          "details.regrets"
        ]
      },
      "pet": {
        "htmlFields": [
          "special"
        ]
      },
      "mount_vehicle": {},
      "npc": {
        "htmlFields": [
          "details.notes",
          "details.special"
        ]
      },
      "mob": {
        "htmlFields": [
          "details.notes",
          "details.special",
          "details.description",
          "details.aiDescription",
          "attributes.treasure"
        ]
      }
    },
    "Item": {
      "skill": {
        "htmlFields": [
          "notes",
          "description"
        ]
      },
      "attack": {
        "htmlFields": [
          "effects"
        ]
      },
      "spell": {
        "htmlFields": [
          "description",
          "quote"
        ]
      },
      "gear": {
        "htmlFields": [
          "notes",
          "description"
        ]
      },
      "race": {
        "htmlFields": [
          "abilities",
          "description"
        ]
      },
      "class": {
        "htmlFields": [
          "abilities",
          "description"
        ]
      },
      "deity": {
        "htmlFields": [
          "boons",
          "description"
        ]
      },
      "sponsor": {
        "htmlFields": [
          "gifts",
          "notes"
        ]
      },
      "loot": {
        "htmlFields": [
          "notes",
          "description"
        ]
      },
      "buff": {
        "htmlFields": [
          "description"
        ]
      },
      "debuff": {
        "htmlFields": [
          "description"
        ]
      },
      "achievement": {
        "htmlFields": [
          "description",
          "quote",
          "rewardContents"
        ]
      }
    }
  },
  "authors": [
    {
      "name": "DCC RPG Community"
    }
  ],
  "scripts": [
    "lib/pdf-lib.min.js"
  ],
  "esmodules": [
    "src/dcc.mjs"
  ],
  "styles": [
    "styles/dcc.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "grid": {
    "distance": 5,
    "units": "ft"
  },
  "primaryTokenAttribute": "attributes.hp",
  "packs": [
    {
      "name": "skills",
      "label": "DCC Skills",
      "path": "packs/skills",
      "type": "Item",
      "system": "carl-rpg",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "spells",
      "label": "DCC Spells",
      "path": "packs/spells",
      "type": "Item",
      "system": "carl-rpg",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "buffs",
      "label": "DCC Buffs & Debuffs",
      "path": "packs/buffs",
      "type": "Item",
      "system": "carl-rpg",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "macros",
      "label": "DCC Macros",
      "path": "packs/macros",
      "type": "Macro",
      "system": "carl-rpg",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "mobs",
      "label": "DCC Mobs",
      "path": "packs/mobs",
      "type": "Actor",
      "system": "carl-rpg",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "items",
      "label": "DCC Items & Loot",
      "path": "packs/items",
      "type": "Item",
      "system": "carl-rpg",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "races",
      "label": "DCC Races",
      "path": "packs/races",
      "type": "Item",
      "system": "carl-rpg",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "classes",
      "label": "DCC Classes",
      "path": "packs/classes",
      "type": "Item",
      "system": "carl-rpg",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "journals",
      "label": "DCC Guides & Journals",
      "path": "packs/journals",
      "type": "JournalEntry",
      "system": "carl-rpg",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    }
  ],
  "flags": {
    "hotReload": {
      "extensions": [
        "css",
        "hbs",
        "html",
        "json",
        "mjs"
      ],
      "paths": [
        "styles",
        "templates",
        "lang",
        "src"
      ]
    }
  }
}
